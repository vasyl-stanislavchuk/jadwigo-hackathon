{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "biome.json",
    "vitest.config.ts",
    "lint/*.grit",
    "mise.toml"
  ],
  "globalPassThroughEnv": ["DATABASE_URL"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:int": {
      "cache": false
    },
    "//#typecheck": {},
    "//#test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
