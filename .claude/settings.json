{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "BEADS_DIR=\"${BEADS_DIR:-$HOME/projects/david-learns/.beads}\" bd prime --hook-json 2>/dev/null || true",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.ts session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.ts pretool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.ts format",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.ts stop",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bd ready *)",
      "Bash(bd ready)",
      "Bash(bd show *)",
      "Bash(bd list *)",
      "Bash(bd update *)",
      "Bash(bd close *)",
      "Bash(bd create *)",
      "Bash(bd dep *)",
      "Bash(bd prime *)",
      "Bash(bd remember *)",
      "Bash(bd recall *)",
      "Bash(bun install)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun run *)",
      "Bash(bun test *)",
      "Bash(bunx turbo run *)",
      "Bash(bunx vitest *)",
      "Bash(bunx biome *)",
      "Bash(bunx knip *)",
      "Bash(bunx depcruise *)",
      "Bash(bunx tsc *)",
      "Bash(make check)",
      "Bash(make check-all)",
      "Bash(make skills)",
      "Bash(uv sync *)",
      "Bash(uv run pytest *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git push *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge * --auto --squash)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(md context *)",
      "Bash(md drops check *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(which *)"
    ]
  }
}
