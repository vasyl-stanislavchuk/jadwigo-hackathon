{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CeilingIsEverythingBelow",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "TheBoundaryIsNotEditable",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": "arn:aws:iam::843109108289:policy/jadwigo-boundary"
    },
    {
      "Sid": "NoRoleSheds",
      "Effect": "Deny",
      "Action": ["iam:DeleteRolePermissionsBoundary", "iam:PutRolePermissionsBoundary"],
      "Resource": "*"
    },
    {
      "Sid": "NewRolesCarryIt",
      "Effect": "Deny",
      "Action": "iam:CreateRole",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::843109108289:policy/jadwigo-boundary"
        }
      }
    },
    {
      "Sid": "NoLongLivedKeys",
      "Effect": "Deny",
      "Action": ["iam:CreateUser", "iam:CreateAccessKey", "iam:CreateLoginProfile"],
      "Resource": "*"
    }
  ]
}
