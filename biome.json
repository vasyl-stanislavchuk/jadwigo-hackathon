{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.venv",
      "!**/schemas/*.json",
      "!packages/contracts/openapi.json",
      "!bun.lock",
      "!packages/copy/src/paraglide"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/*/src/**/*.ts",
        "apps/*/src/**/*.tsx",
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "!**/src/config.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!packages/testing/**"
      ],
      "plugins": ["./lint/no-raw-process-env.grit"]
    },
    {
      "includes": [
        "apps/*/src/**/*.ts",
        "apps/*/src/**/*.tsx",
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.contract.ts",
        "!packages/testing/**",
        "!packages/contracts/src/ids.ts",
        "!packages/contracts/src/routes.ts",
        "!packages/contracts/src/wire.ts"
      ],
      "plugins": ["./lint/boundary-constants.grit"]
    },
    {
      "includes": [
        "apps/web/src/**/*.tsx",
        "packages/lesson-kit/src/**/*.tsx",
        "!apps/web/src/playground/**",
        "!**/*.test.tsx"
      ],
      "plugins": ["./lint/no-jsx-literal.grit"]
    },
    {
      "includes": [".claude/hooks/**", "tools/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/lesson-kit/src/**", "apps/web/src/**"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/lesson-kit/src/**/*.test.ts",
        "packages/lesson-kit/src/**/*.test.tsx",
        "apps/web/src/**/*.test.ts",
        "apps/web/src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
