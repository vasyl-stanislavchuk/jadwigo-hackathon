{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/contracts/openapi.json",
        "$TURBO_ROOT$/apps/cli/mcp-tools.json",
        "$TURBO_ROOT$/packages/ui/src/styles/*.css",
        "$TURBO_ROOT$/packages/lesson-kit/src/families/questionTypes.ts",
        "$TURBO_ROOT$/packages/api-client/src/**",
        "$TURBO_ROOT$/packages/contracts/src/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/cli/mcp-tools.json",
        "$TURBO_ROOT$/packages/ui/src/styles/*.css",
        "$TURBO_ROOT$/packages/lesson-kit/src/families/questionTypes.ts",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/cli/mcp-tools.json",
        "$TURBO_ROOT$/packages/lesson-kit/src/families/questionTypes.ts"
      ]
    }
  }
}
