flowchart LR
  web["Web app<br/>React, app.jadwigo.pl"]
  gateway["API Gateway<br/>throttles, checks the JWT"]
  api["API<br/>1 Lambda, every route"]
  bank[("Question bank<br/>search and item bodies")]
  uploads[("Uploads<br/>S3, photos per family")]
  converter["Converter<br/>PDF, DOCX, HEIC to JPEG"]
  runner["Runner<br/>2nd Lambda, AI steps"]
  db[("Postgres<br/>Supabase, row-level security")]
  muse["Meta Muse<br/>/v1/responses"]
  web -- JSON --> gateway
  gateway --> api
  api -- search --> bank
  api -- "1 transaction" --> db
  api -. "async poke" .-> runner
  runner -- steps --> db
  runner -- "S3 keys" --> converter
  converter -- JPEGs --> uploads
  runner -- "reads photos" --> uploads
  web -- "photo upload" --> uploads
  runner -- "1 call per step" --> muse
