---
// Direction 1a, "Partner" (design handoff "landing 3", owner, 2026-11-01): learning the parent is close
// to (decision dl-w0b4.124). Beside it, Tymek's short story from the demo film (dl-w0b4.143), which
// replaced the screenshot of the app's child page (dl-w0b4.123): his page in the app's own lists, a new
// lesson, and the sheet it makes landing on his table. Tymek is made up, never a real learner.
// Two sides (dl-w0b4.146): the heading, the text and Tymek's child page on one, his table on the other.
// The sprout picture that stood under the text is gone.
import type { Language } from "@jadwigo/config";
import { landingWords } from "../lib/words.ts";
import TymekStory from "./TymekStory.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const p = (await landingWords(lang)).partner;
---

<section class="partner wrap" aria-labelledby="partner-title">
  <div class="lead">
    <h2 id="partner-title">{p.heading}</h2>
    <p class="text">{p.text}</p>
    <TymekStory lang={lang} part="page" />
  </div>
  <TymekStory lang={lang} part="table" />
</section>

<style>
  .partner { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56rem) { .partner { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }
  .lead { display: flex; flex-direction: column; gap: 0.75rem; }
  /* The section heading on the adult scale (dl-w0b4.124). */
  .lead h2 { font-size: var(--jw-page-h1); max-width: 18ch; }
  .text { font-size: 1.15rem; color: var(--jw-ink-soft); }
  .lead :global(.window) { margin-top: 0.75rem; }
</style>
