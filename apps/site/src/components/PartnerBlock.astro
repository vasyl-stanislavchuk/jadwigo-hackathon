---
// Direction 1a, "Partner" (design handoff "landing 3", owner, 2026-11-01): learning the parent is close
// to, beside a real screenshot of the parent app's child page in an app window (dl-w0b4.123, decision
// dl-w0b4.124). The screenshot is taken on the local stack with made-up names only (Marta), never a
// real learner, at 1440 wide and cropped to the content column; one per language.
// The picture: a sprout grows out of the pencil pot faster than the court can keep up (owner,
// 2026-11-02, dl-5ssh.4.48). A still; the blinking table picture moved to the hero.
import type { Language } from "@jadwigo/config";
import shotEn from "../assets/app-child-page-en.webp";
import shotPl from "../assets/app-child-page-pl.webp";
import { slotArt } from "../lib/illustrations.ts";
import { landingWords } from "../lib/words.ts";
import Pic from "./Pic.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const p = (await landingWords(lang)).partner;
const shot = lang === "en" ? shotEn : shotPl;
---

<section class="partner wrap" aria-labelledby="partner-title">
  <div class="lead">
    <h2 id="partner-title">{p.heading}</h2>
    <p class="text">{p.text}</p>
    <Pic label={p.pic} src={slotArt.partnerGrow} sizes="(max-width: 40rem) 100vw, 34rem" class="partner-pic" />
  </div>
  <Pic label={p.app} src={shot} screen sizes="(max-width: 56rem) 100vw, 36rem" class="app-shot" />
</section>

<style>
  .partner { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56rem) { .partner { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }
  .lead { display: flex; flex-direction: column; gap: 0.75rem; }
  /* The section heading on the adult scale (dl-w0b4.124). */
  .lead h2 { font-size: var(--jw-page-h1); max-width: 18ch; }
  .text { font-size: 1.15rem; color: var(--jw-ink-soft); }
  .lead :global(.partner-pic) { margin-top: 0.75rem; height: clamp(10rem, 22vw, 15rem); }
</style>
