---
import { Image } from "astro:assets";
// Direction 1a, "Partner" (design handoff "landing 3", owner, 2026-11-01): learning the parent is close
// to, beside a simplified child profile from the parent app's child page. A made-up child (never a real
// learner), 3 goals, 4 skill dots each (filled = can do, ink ring = practising now, dashed = next), the
// goal's second line and the next lesson. No percentages, no status words, no recent lessons: the owner
// asked to keep it this simple. The dots carry their meaning in text for a screen reader.
// The picture's Queen blinks once, slowly, when it is 60% in view (dl-5ssh.4.25, the owner's one
// exception to "motion only in the hero clip and the 404"): her closed eyes fade in over the open ones
// and out again. Once per page view, never under reduced motion, and without JS the picture stays.
import type { Language } from "@jadwigo/config";
import { blinkEyes, slotArt } from "../lib/illustrations.ts";
import { goalLine } from "../lib/landing.ts";
import { landingWords } from "../lib/words.ts";

interface Props {
  lang: Language;
}

const p = (await landingWords(Astro.props.lang)).partner;
---

<section class="partner wrap" aria-labelledby="partner-title">
  <div class="lead">
    <h2 id="partner-title">{p.heading}</h2>
    <p class="text">{p.text}</p>
    <div class="partner-pic">
      <div class="frame" data-blink>
        <Image
          class="base"
          src={slotArt.partner}
          alt={p.pic}
          widths={[320, 640, 960, 1280, slotArt.partner.width]}
          sizes="(max-width: 40rem) 100vw, 34rem"
        />
        <Image class="blink-eyes" src={blinkEyes} alt="" aria-hidden="true" />
      </div>
    </div>
  </div>
  <div class="profile">
    <div class="child">
      <span class="avatar" aria-hidden="true">{p.child.initial}</span>
      <span>
        <strong>{p.child.name}</strong>
        <span class="sub">{p.child.sub}</span>
      </span>
    </div>
    <ul class="goals">
      {
        p.goals.map((g) => (
          <li>
            <span class="goal">
              <strong>{g.name}</strong>
              <span class="dots" role="img" aria-label={g.skills.map((s) => `${s.name}: ${p.states[s.state]}`).join(", ")}>
                {g.skills.map((s) => (
                  <i class={s.state} />
                ))}
              </span>
            </span>
            <span class="line">{goalLine(g.skills, p)}</span>
          </li>
        ))
      }
    </ul>
    <p class="next-lesson"><strong>{p.nextLabel}</strong> {p.next}</p>
  </div>
</section>

<script>
  // The first blink once 60% of the picture is in view; then one more every 5 to 10 s, at random, while
  // it is in view and the tab is showing (owner, 2026-11-02, dl-5ssh.4.27). Under reduced motion the CSS
  // runs no animation, so no animationend comes and nothing repeats.
  const frame = document.querySelector<HTMLElement>("[data-blink]");
  const eyes = frame?.querySelector(".blink-eyes");
  if (frame && eyes) {
    let inView = false;
    let waiting = false;
    const blink = () => {
      waiting = false;
      frame.classList.remove("go");
      void frame.offsetWidth; // restart the CSS animation
      frame.classList.add("go");
    };
    // The CSS waits 0.7 s before closing her eyes, so the gap from one blink to the next is 5 to 10 s.
    const next = () => setTimeout(() => (inView && !document.hidden ? blink() : (waiting = true)), 4300 + Math.random() * 5000);
    eyes.addEventListener("animationend", next);
    document.addEventListener("visibilitychange", () => {
      if (waiting && inView && !document.hidden) blink();
    });
    new IntersectionObserver(
      (entries) => {
        inView = entries.some((e) => e.isIntersecting);
        if (inView && (waiting || !frame.classList.contains("go"))) blink();
      },
      { threshold: 0.6 },
    ).observe(frame);
  }
</script>

<style>
  .partner { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56rem) { .partner { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }
  .lead { display: flex; flex-direction: column; gap: 0.75rem; }
  .lead h2 { font-size: clamp(1.9rem, 4vw, 2.6rem); line-height: 1.12; max-width: 18ch; }
  .text { font-size: 1.15rem; color: var(--jw-ink-soft); }
  .partner-pic { margin-top: 0.75rem; height: clamp(10rem, 22vw, 15rem); display: grid; place-items: center; }
  /* The picture keeps its own shape inside the slot, so the eyes patch, placed in percent of the
     picture, stays on her face at every width. The base and the patch each have their own rule: a
     shared img rule once stretched the patch over the whole picture. */
  .frame { position: relative; height: 100%; max-width: 100%; aspect-ratio: 1600 / 712; }
  /* The table's 2 bottom corners, rounded (owner, 2026-11-02, dl-5ssh.4.27). The table is a rectangle
     inside the picture (x 45 to 1554, bottom at y 667 of 1600x712), so the clip is in the picture's own
     percent and cuts only those corners: the notebook below the table and everything else stay. */
  .frame .base {
    display: block; width: 100%; height: 100%;
    clip-path: polygon(0.000% 0.000%, 100.000% 0.000%, 100.000% 89.466%, 97.125% 89.466%, 97.089% 90.288%, 96.982% 91.079%, 96.809% 91.807%, 96.576% 92.446%, 96.292% 92.970%, 95.968% 93.359%, 95.616% 93.599%, 95.250% 93.680%, 95.250% 100.000%, 4.688% 100.000%, 4.688% 93.680%, 4.322% 93.599%, 3.970% 93.359%, 3.646% 92.970%, 3.362% 92.446%, 3.128% 91.807%, 2.955% 91.079%, 2.849% 90.288%, 2.812% 89.466%, 0.000% 89.466%);
  }
  .frame .blink-eyes {
    position: absolute; display: block; left: 50%; top: 62.293%; width: 6.634%; height: 7.459%;
    opacity: 0; pointer-events: none;
  }
  /* One slow, content blink: close in about 0.12 s, hold, open; then rest. */
  .frame.go .blink-eyes { animation: slow-blink 1.1s ease-in-out 0.7s 1 both; }
  @keyframes slow-blink { 0% { opacity: 0; } 11% { opacity: 1; } 55% { opacity: 1; } 68% { opacity: 0; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .frame.go .blink-eyes { animation: none; } }
  .profile {
    padding: 1.25rem; border: 2px solid var(--jw-line); border-radius: var(--jw-radius-card);
    background: var(--jw-card); box-shadow: 0 5px 0 var(--jw-line);
  }
  .child { display: flex; align-items: center; gap: 0.75rem; }
  .child strong { display: block; font-size: 1.15rem; line-height: 1.2; }
  .sub { font-size: 0.85rem; color: var(--jw-ink-soft); }
  .avatar {
    width: 2.6rem; height: 2.6rem; flex: none; display: grid; place-items: center; border-radius: 50%;
    background: var(--jw-pick); color: var(--jw-pick-ink); font-weight: 700;
  }
  .goals { list-style: none; margin: 1.25rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .goals li { display: flex; flex-direction: column; gap: 0.15rem; }
  .goal { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .goal strong { font-size: 1rem; }
  .line { font-size: 0.9rem; color: var(--jw-ink-soft); }
  .dots { display: flex; gap: 0.3rem; flex: none; }
  .dots i { width: 14px; height: 14px; border-radius: 50%; box-sizing: border-box; }
  .dots .done { background: var(--jw-right-edge); }
  .dots .now { border: 2px solid var(--jw-ink); }
  .dots .next { border: 2px dashed var(--jw-ink-soft); }
  .next-lesson { margin-top: 1.25rem; padding-top: 1rem; border-top: 2px solid var(--jw-line); font-size: 0.95rem; }
</style>
