---
import { Image } from "astro:assets";
// A slot for an illustration, a photo or a screencast still to come: a quiet grey box whose label says
// what goes in it (design handoff "landing 3", Pic; the ideas per slot are its illustrations.csv).
// The owner keeps the slots visible until the art exists (2026-11-01). `screen` draws it as a browser
// window with a play button, for a screencast. The box fills its parent unless `ratio` sets its shape.
// With `src` the slot's art has come (dl-5ssh.4.24): the picture fills the same box, contained and
// uncut, on the page itself (no grey, no border), and the label is its alt text. With `src` and `screen`,
// a screenshot of the app: the picture at its own shape under the window's bar, on a 1 px line.
import type { ImageMetadata } from "astro";

interface Props {
  label: string;
  src?: ImageMetadata | undefined;
  // The picture's rendered width, for the srcset (the `sizes` attribute).
  sizes?: string;
  // Above the fold (the hero): fetched at once, not lazily.
  eager?: boolean;
  ratio?: string;
  screen?: boolean;
  // A clip in the site bucket's about-photos/, never in git: it loops silently in the window, and stays on
  // its poster with reduced motion. `label` names it.
  clip?: { src: string; poster: string } | undefined;
  class?: string;
}

const {
  label,
  src,
  eager = false,
  sizes = "(max-width: 40rem) 100vw, 40rem",
  ratio,
  screen = false,
  clip,
  class: extra,
} = Astro.props;
const style = ratio ? `aspect-ratio: ${ratio}` : undefined;
// Never upscaled: each width the source has, then the source itself.
const widths = src ? [...[320, 640, 960, 1280].filter((w) => w < src.width), src.width] : [];
---

{
  clip ? (
    <div class:list={["pic", "shot", extra]}>
      <span class="bar" aria-hidden="true"><i></i><i></i><i></i></span>
      <video data-clip src={clip.src} poster={clip.poster} autoplay muted loop playsinline preload="metadata" aria-label={label}></video>
    </div>
  ) : src ? (
    <div class:list={["pic", screen ? "shot" : "art", "fade-in", extra]} style={style}>
      {screen && <span class="bar" aria-hidden="true"><i></i><i></i><i></i></span>}
      <Image src={src} alt={label} widths={widths} sizes={sizes} loading={eager ? "eager" : "lazy"} />
    </div>
  ) : (
    <div class:list={["pic", { screen }, extra]} style={style} role="img" aria-label={label}>
      {screen && <span class="bar" aria-hidden="true"><i></i><i></i><i></i></span>}
      <span class="body" aria-hidden="true">
        {screen && <span class="play" />}
        <span class="label">{label}</span>
      </span>
    </div>
  )
}

<script>
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const video of document.querySelectorAll<HTMLVideoElement>("video[data-clip]")) video.pause();
  }
</script>

<style>
  .pic {
    display: flex; flex-direction: column; width: 100%; height: 100%; min-height: 6rem;
    background: var(--jw-act-quiet); border: var(--jw-border) solid var(--jw-line); border-radius: var(--jw-radius-small);
    color: var(--jw-on-act-quiet, var(--jw-ink-soft)); font-size: 0.9rem; font-weight: 700; text-align: center;
    overflow: hidden;
  }
  .art { background: none; border: 0; border-radius: 0; }
  .art img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .shot { height: auto; min-height: 0; background: var(--jw-card); border-radius: var(--jw-radius-card); }
  .shot img { display: block; width: 100%; height: auto; }
  .shot video { display: block; width: 100%; height: auto; }
  /* On a phone the screenshot stays readable: wider than its column, cut on the right. */
  @media (max-width: 40rem) { .shot img { width: 34rem; max-width: none; } }
  .body { flex: 1; display: grid; place-content: center; justify-items: center; gap: 0.75rem; padding: 0.5rem; }
  .label { max-width: 32ch; text-wrap: balance; }
  .screen { border-color: var(--jw-ink); border-radius: var(--jw-radius-card); }
  .bar { display: flex; gap: 0.35rem; padding: 0.5rem 0.75rem; background: var(--jw-card); border-bottom: var(--jw-border) solid var(--jw-line); }
  .bar i { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--jw-line-strong); }
  .play {
    width: 3.5rem; height: 3.5rem; border-radius: 50%; border: var(--jw-border) solid var(--jw-ink); background: var(--jw-card);
    display: grid; place-items: center;
  }
  .play::after {
    content: ""; margin-left: 0.25rem;
    border-left: 1rem solid var(--jw-ink); border-top: 0.6rem solid transparent; border-bottom: 0.6rem solid transparent;
  }
</style>
