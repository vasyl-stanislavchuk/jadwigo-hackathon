---
// A slot for an illustration, a photo or a screencast still to come: a quiet grey box whose label says
// what goes in it (design handoff "landing 3", Pic; the ideas per slot are its illustrations.csv).
// The owner keeps the slots visible until the art exists (2026-11-01). `screen` draws it as a browser
// window with a play button, for a screencast. The box fills its parent unless `ratio` sets its shape.
interface Props {
  label: string;
  ratio?: string;
  screen?: boolean;
  class?: string;
}

const { label, ratio, screen = false, class: extra } = Astro.props;
---

<div class:list={["pic", { screen }, extra]} style={ratio ? `aspect-ratio: ${ratio}` : undefined} role="img" aria-label={label}>
  {screen && <span class="bar" aria-hidden="true"><i></i><i></i><i></i></span>}
  <span class="body" aria-hidden="true">
    {screen && <span class="play" />}
    <span class="label">{label}</span>
  </span>
</div>

<style>
  .pic {
    display: flex; flex-direction: column; width: 100%; height: 100%; min-height: 6rem;
    background: var(--jw-act-quiet); border: 2px solid var(--jw-line); border-radius: var(--jw-radius-small);
    color: var(--jw-on-act-quiet, var(--jw-ink-soft)); font-size: 0.9rem; font-weight: 700; text-align: center;
    overflow: hidden;
  }
  .body { flex: 1; display: grid; place-content: center; justify-items: center; gap: 0.75rem; padding: 0.5rem; }
  .label { max-width: 32ch; text-wrap: balance; }
  .screen { border-color: var(--jw-ink); border-radius: var(--jw-radius-card); }
  .bar { display: flex; gap: 0.35rem; padding: 0.5rem 0.75rem; background: var(--jw-card); border-bottom: 2px solid var(--jw-line); }
  .bar i { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--jw-line-strong); }
  .play {
    width: 3.5rem; height: 3.5rem; border-radius: 50%; border: 2px solid var(--jw-ink); background: var(--jw-card);
    display: grid; place-items: center;
  }
  .play::after {
    content: ""; margin-left: 0.25rem;
    border-left: 1rem solid var(--jw-ink); border-top: 0.6rem solid transparent; border-bottom: 0.6rem solid transparent;
  }
</style>
