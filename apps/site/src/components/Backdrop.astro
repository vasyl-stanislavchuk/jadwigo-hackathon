---
// A living page behind every page (dl-5ssh.4.33): true sums from grades 1-3 and small stars drift
// slowly, as if on the kitchen table's evening air. The sums are what a child learns here, every one of
// them right; the stars are the ones a right answer earns (owner, 2026-11-02, dl-5ssh.4.39: "Sums +
// stars", so the background means something). With a fine pointer, everything near it leans away, the
// stars twinkle and the sums brighten, and a faint glow follows it, after shelestni's landing page, in
// Jadwigo's own theme and with no library. The build places a page that stands without JS; every visit
// then deals new sums and new places (dl-5ssh.4.38). Under reduced motion nothing moves. The layer is
// decoration only: aria-hidden, no pointer events, quiet enough that the words on top stay easy to read.
import type { Language } from "@jadwigo/config";
import { trueSum } from "../lib/sums.ts";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

// Quiet Zeszyt colours: blue ink, the brand's go-blue and the right answer's green. No yellow: crown
// yellow is the brand's only.
const TONES = ["act", "go", "green"] as const;
// The layer is as tall as the page and scrolls with it, so the counts cover a long page.
const SUMS = 30;
const STARS = 34;

// A small fixed sequence (mulberry32), so every build draws the same page.
let seed = 0x1a2b3c4d;
const next = (): number => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const between = (lo: number, hi: number): number => lo + next() * (hi - lo);

const place = (size: number): string =>
  [
    `left: ${between(0, 96).toFixed(2)}%`,
    `top: ${between(0, 100).toFixed(2)}%`,
    `font-size: ${size.toFixed(2)}rem`,
    `--drift-x: ${between(-1.5, 1.5).toFixed(2)}rem`,
    `--drift-y: ${between(-1.5, 1.5).toFixed(2)}rem`,
    `--turn: ${Math.round(between(-12, 12))}deg`,
    `--time: ${between(14, 26).toFixed(1)}s`,
    `--delay: ${(-between(0, 26)).toFixed(1)}s`,
  ].join("; ");

const pieces = [
  ...Array.from({ length: SUMS }, () => ({
    kind: "sum" as const,
    text: trueSum(next, lang),
    tone: TONES[Math.floor(next() * TONES.length)] ?? "act",
    style: place(between(0.85, 1.2)),
  })),
  ...Array.from({ length: STARS }, () => ({
    kind: "star" as const,
    text: "",
    tone: next() < 0.5 ? ("go" as const) : ("green" as const),
    style: place(between(0.55, 1)),
  })),
];
---

<div class="backdrop" aria-hidden="true" data-lang={lang}>
  <div class="glow"></div>
  {
    pieces.map((p) => (
      <span class:list={["piece", p.kind, p.tone]} style={p.style}>
        <span class="drift">
          {p.kind === "sum" ? (
            p.text
          ) : (
            <svg viewBox="0 0 20 20" width="1em" height="1em">
              <path d="M10 0 C11 7 13 9 20 10 C13 11 11 13 10 20 C9 13 7 11 0 10 C7 9 9 7 10 0 Z" fill="currentColor" />
            </svg>
          )}
        </span>
      </span>
    ))
  }
</div>

<script>
  import { trueSum } from "../lib/sums.ts";

  // Once the font is in, so the words are measured at their real size before the pieces avoid them.
  const start = (backdrop: HTMLElement) => {
    // Every visit deals new sums and new places (dl-5ssh.4.38). Only this decorative layer changes, so no
    // content shifts; under reduced motion the pieces land and stay. How many show follows the page's
    // length, and none lands on the words, a field or a picture: a short page such as the sign-in stays
    // calm (owner, 2026-11-02: "a bit too much on a screen with few elements").
    const lang = backdrop.dataset["lang"] === "en" ? "en" : "pl";
    const between = (lo: number, hi: number): number => lo + Math.random() * (hi - lo);
    const layer = backdrop.getBoundingClientRect();
    const W = layer.width;
    const H = layer.height;
    // About 6 sums and 7 stars for each screen-height of page.
    const screens = Math.max(1, H / Math.max(innerHeight, 600));
    const room = { sum: Math.round(6 * screens), star: Math.round(7 * screens) };
    // What a piece must keep clear of, in the layer's own coordinates, with a little air around it.
    const AIR = 14;
    const taken = [
      ...document.querySelectorAll(
        "header, footer, main :is(h1, h2, h3, p, li, label, input, button, a, img, video, table, form, blockquote, .paper, .card, .pic, .tile)",
      ),
    ]
      .map((e) => e.getBoundingClientRect())
      .filter((r) => r.width > 0 && r.height > 0)
      .map((r) => ({
        left: r.left - layer.left - AIR,
        top: r.top - layer.top - AIR,
        right: r.right - layer.left + AIR,
        bottom: r.bottom - layer.top + AIR,
      }));
    const clear = (l: number, t: number, w: number, h: number): boolean =>
      taken.every((r) => l + w < r.left || l > r.right || t + h < r.top || t > r.bottom);
    const placed = { sum: 0, star: 0 };
    for (const piece of backdrop.querySelectorAll<HTMLElement>(".piece")) {
      const kind = piece.classList.contains("sum") ? "sum" : "star";
      const drift = piece.querySelector(".drift");
      if (drift && kind === "sum") drift.textContent = trueSum(Math.random, lang);
      const w = piece.offsetWidth;
      const h = piece.offsetHeight;
      let spot: [number, number] | undefined;
      for (let tries = 0; tries < 12 && placed[kind] < room[kind] && !spot; tries++) {
        const l = between(0, Math.max(0, W - w));
        const t = between(0, Math.max(0, H - h));
        if (clear(l, t, w, h)) spot = [l, t];
      }
      if (!spot) {
        piece.hidden = true;
        continue;
      }
      placed[kind]++;
      piece.hidden = false;
      piece.style.left = `${((spot[0] / W) * 100).toFixed(2)}%`;
      piece.style.top = `${((spot[1] / H) * 100).toFixed(2)}%`;
      piece.style.setProperty("--drift-x", `${between(-1.5, 1.5).toFixed(2)}rem`);
      piece.style.setProperty("--drift-y", `${between(-1.5, 1.5).toFixed(2)}rem`);
      piece.style.setProperty("--turn", `${Math.round(between(-12, 12))}deg`);
      piece.style.setProperty("--delay", `${(-between(0, 26)).toFixed(1)}s`);
    }

    // The cursor's part, on a fine pointer only and never under reduced motion: the glow follows it,
    // everything within reach leans away, the stars twinkle and the sums brighten, then all settle back.
    const fine = matchMedia("(pointer: fine)").matches;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (fine && !still) {
      const pieces = [...backdrop.querySelectorAll<HTMLElement>(".piece:not([hidden])")];
      // Livelier than dl-5ssh.4.35's calm lean (owner, 2026-11-02: "move a bit more actively").
      const REACH = 170; // px
      const PUSH = 22; // px at the cursor itself
      // The cursor on the page, not the screen: the layer scrolls with the page, and only the mouse
      // moves the pieces.
      let x = -1000;
      let y = -1000;
      let queued = false;
      const frame = () => {
        queued = false;
        backdrop.style.setProperty("--glow-x", `${x}px`);
        backdrop.style.setProperty("--glow-y", `${y}px`);
        const top = backdrop.getBoundingClientRect().top;
        for (const p of pieces) {
          const r = p.getBoundingClientRect();
          const dx = r.left + r.width / 2 - x;
          const dy = r.top - top + r.height / 2 - y;
          const d = Math.hypot(dx, dy);
          if (d > REACH || d === 0) {
            p.classList.remove("near");
            p.style.removeProperty("--away-x");
            p.style.removeProperty("--away-y");
            continue;
          }
          const f = (1 - d / REACH) * PUSH;
          p.classList.add("near");
          p.style.setProperty("--away-x", `${((dx / d) * f).toFixed(1)}px`);
          p.style.setProperty("--away-y", `${((dy / d) * f).toFixed(1)}px`);
        }
      };
      addEventListener(
        "pointermove",
        (e) => {
          x = e.pageX;
          y = e.pageY;
          backdrop.classList.add("lit");
          if (!queued) {
            queued = true;
            requestAnimationFrame(frame);
          }
        },
        { passive: true },
      );
      document.documentElement.addEventListener("pointerleave", () => backdrop.classList.remove("lit"));
    }
  }
  const backdrop = document.querySelector<HTMLElement>(".backdrop");
  if (backdrop) void document.fonts.ready.then(() => start(backdrop));
</script>

<style>
  /* As tall as the page and scrolling with it (the body is its containing block). */
  .backdrop { position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  /* A faint glow, the evening lamp over the table: the page's own quiet paper tone, barely there. */
  .glow {
    position: absolute; left: 0; top: 0; width: 22rem; height: 22rem; border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--jw-act-quiet) 40%, transparent), transparent);
    transform: translate(calc(var(--glow-x, -100vw) - 50%), calc(var(--glow-y, -100vh) - 50%));
    opacity: 0; transition: opacity 1.2s ease;
  }
  .lit .glow { opacity: 1; }
  .piece[hidden] { display: none; }
  .piece {
    position: absolute; line-height: 1; white-space: nowrap; user-select: none;
    transform: translate(var(--away-x, 0), var(--away-y, 0));
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), color 0.6s ease;
  }
  .sum { font-weight: 700; letter-spacing: 0.02em; }
  .star svg { display: block; }
  /* A star twinkles under the cursor: it grows and turns a quarter, and brightens. */
  .star.near { transform: translate(var(--away-x, 0), var(--away-y, 0)) scale(1.7) rotate(45deg); }
  .drift { display: block; animation: drift var(--time) ease-in-out var(--delay) infinite alternate; }
  @keyframes drift {
    from { transform: translate(0, 0) rotate(0deg); }
    to { transform: translate(var(--drift-x), var(--drift-y)) rotate(var(--turn)); }
  }
  /* Quiet: each piece is its colour mixed far into the page, so text on top keeps its contrast. Near
     the cursor it comes forward a little. */
  .act { color: color-mix(in srgb, var(--jw-act) 50%, var(--jw-ground)); }
  .go { color: color-mix(in srgb, var(--jw-brand-go) 26%, var(--jw-ground)); }
  .green { color: color-mix(in srgb, var(--jw-right-edge) 26%, var(--jw-ground)); }
  .act.near { color: color-mix(in srgb, var(--jw-act) 85%, var(--jw-ground)); }
  .go.near { color: color-mix(in srgb, var(--jw-brand-go) 55%, var(--jw-ground)); }
  .green.near { color: color-mix(in srgb, var(--jw-right-edge) 55%, var(--jw-ground)); }
  @media (prefers-reduced-motion: reduce) {
    .drift { animation: none; }
    .piece { transition: none; }
  }
</style>
