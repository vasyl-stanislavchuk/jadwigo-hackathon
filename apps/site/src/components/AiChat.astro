---
// The picture beside /jadwigo-ai's intro (dl-w0b4.127), after the film's "Also in your own AI app"
// frame: a chat window with the court standing on top of it, a parent's photo and request, and the
// question that comes back. Drawn in HTML so its words follow the language.
import { Image } from "astro:assets";
import { courtArt } from "../lib/illustrations.ts";

interface Props {
  words: {
    alt: string;
    ask: string;
    say: string;
    sum: string;
    answer: string;
    well: string;
    next: string;
  };
  apps: readonly string[];
}

const { words, apps } = Astro.props;
---

<div class="chat-pic" role="img" aria-label={words.alt}>
  <div class="court">
    {courtArt.map((src) => <Image src={src} alt="" widths={[src.width]} sizes="5rem" />)}
  </div>
  <div class="window">
    <span class="bar"><i></i><i></i><i></i></span>
    <div class="body">
      <p class="ask">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <rect x="3" y="6.5" width="18" height="13" rx="2.5"></rect>
          <circle cx="12" cy="13" r="3.5"></circle>
          <path d="M8.5 6.5 10 4h4l1.5 2.5"></path>
        </svg>
        <span>{words.ask}</span>
      </p>
      <div class="sheet paper" data-audience="kid">
        <p class="say">{words.say}</p>
        <p class="sum">{words.sum} <b>{words.answer}</b></p>
        <p class="well"><span>{words.well}</span><em>{words.next}</em></p>
      </div>
    </div>
  </div>
  <ul class="apps">{apps.map((a) => <li>{a}</li>)}</ul>
</div>

<style>
  .chat-pic { display: flex; flex-direction: column; min-width: 0; }
  .court { display: flex; justify-content: space-around; align-items: flex-end; padding: 0 1.5rem; }
  .court img { display: block; height: clamp(4rem, 9vw, 5.5rem); width: auto; margin-bottom: -2px; }
  .window { overflow: hidden; background: var(--jw-card); border: 2px solid var(--jw-ink); border-radius: var(--jw-radius-card); }
  .bar { display: flex; gap: 0.3rem; padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--jw-line); background: var(--secondary); }
  .bar i { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--jw-line); }
  .body { display: flex; flex-direction: column; gap: 0.9rem; padding: 1rem; }
  .ask {
    display: flex; align-items: center; gap: 0.6rem; align-self: flex-end; max-width: 85%; padding: 0.6rem 0.8rem;
    background: var(--jw-act-quiet); border-radius: var(--jw-radius-card); font-size: 0.95rem; line-height: 1.3;
  }
  .ask svg { flex: none; }
  .sheet { align-self: flex-start; width: min(100%, 22rem); padding: 0.9rem; border-radius: var(--jw-radius-small); }
  .say { font-size: 0.95rem; font-weight: 700; line-height: 1.3; }
  .sum { margin-top: 0.5rem; font-size: 1.3rem; font-weight: 700; }
  .sum b { padding: 0 0.5rem; border: 1px solid var(--jw-brand-go); border-radius: var(--jw-radius-small); color: var(--jw-brand-go); }
  .well { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: 0.6rem; font-weight: 700; color: var(--jw-brand-go); }
  .well em { padding: 0.15rem 0.7rem; border: 1px solid var(--jw-brand-go); border-radius: var(--jw-radius-small); font-style: normal; font-size: 0.9rem; }
  .apps { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin: 0.9rem 0 0; padding: 0; }
  .apps li { padding: 0.2rem 0.85rem; border: 1px solid var(--jw-line); border-radius: 999px; background: var(--jw-card); font-size: 0.9rem; font-weight: 600; }
</style>
