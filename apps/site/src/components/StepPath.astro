---
// How it works as one path (owner, 2026-11-02, dl-5ssh.4.50): "make component 1-2-3 nicely showing that
// these follow 1 after another". 3 numbered stops joined by a dashed pencil line with an arrow to the
// next stop: across the page from 52rem, down its left edge on a phone. The stop's colour says whose
// turn it is (the parent's: pick blue; the child's: right green), which the words say too.
// Once, when the path first comes into view, the line draws itself from 1 to 3 and each stop lands as
// the line reaches it. Without JS or under reduced motion the path is simply there.
interface Step {
  who: string;
  title: string;
  text: string;
  // Whose turn: the parent's or the child's.
  turn: "parent" | "child";
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="path" data-path style={`--stops: ${steps.length}`}>
  {
    steps.map((s, i) => (
      <li class:list={["stop", s.turn]} style={`--i: ${i}`}>
        <span class="disc" aria-hidden="true">{i + 1}</span>
        <div class="words">
          <p class="who">{s.who}</p>
          <h3>{s.title}</h3>
          <p class="text">{s.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<script>
  // Draw the path once, the first time 40% of it is in view.
  for (const path of document.querySelectorAll<HTMLElement>("[data-path]")) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) continue;
    path.classList.add("waiting");
    const seen = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        path.classList.add("drawn");
        seen.disconnect();
      },
      { threshold: 0.4 },
    );
    seen.observe(path);
  }
</script>

<style>
  .path {
    --disc: 3.5rem;
    --gap: 2rem;
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--gap);
  }
  .stop { position: relative; display: grid; grid-template-columns: var(--disc) 1fr; column-gap: 1rem; align-items: start; align-content: start; }
  .disc {
    position: relative; z-index: 1;
    width: var(--disc); height: var(--disc); display: grid; place-items: center;
    border: 2px solid var(--jw-ink); border-radius: 50%; box-shadow: 0 4px 0 var(--jw-line);
    font-size: 1.6rem; font-weight: 700; line-height: 1;
  }
  .parent .disc { background: var(--jw-pick); color: var(--jw-pick-ink); }
  .child .disc { background: var(--jw-right); color: var(--jw-right-ink); }
  .words { padding-top: 0.2rem; }
  .who { font-size: 0.95rem; font-weight: 700; color: var(--jw-ink-soft); }
  .stop h3 { margin-top: 0.15rem; font-size: 1.2rem; line-height: 1.3; }
  .text { margin-top: 0.4rem; color: var(--jw-ink-soft); max-width: 34ch; }

  /* The line from a stop to the next one, with an arrow at its end. On a phone it runs down from
     under the disc to the next disc. */
  .stop:not(:last-child)::before {
    content: ""; position: absolute;
    left: calc(var(--disc) / 2 - 1px); top: calc(var(--disc) + 0.5rem); bottom: calc(-1 * var(--gap) + 0.6rem);
    border-left: 2px dashed var(--jw-line-strong);
    transform-origin: top;
  }
  .stop:not(:last-child)::after {
    content: ""; position: absolute;
    left: calc(var(--disc) / 2 - 0.35rem); bottom: calc(-1 * var(--gap) + 0.55rem);
    width: 0.55rem; height: 0.55rem;
    border-right: 2px solid var(--jw-line-strong); border-bottom: 2px solid var(--jw-line-strong);
    transform: rotate(45deg);
  }

  /* From 52rem: the stops stand side by side, each disc above its words, and the line runs across. */
  @media (min-width: 52rem) {
    .path { --gap: 2.5rem; grid-template-columns: repeat(var(--stops), 1fr); }
    .stop { grid-template-columns: 1fr; row-gap: 1rem; }
    .stop:not(:last-child)::before {
      left: calc(var(--disc) + 0.75rem); right: calc(-1 * var(--gap) + 0.85rem);
      top: calc(var(--disc) / 2 - 1px); bottom: auto;
      border-left: 0; border-top: 2px dashed var(--jw-line-strong);
      transform-origin: left;
    }
    .stop:not(:last-child)::after {
      left: auto; right: calc(-1 * var(--gap) + 0.8rem); bottom: auto;
      top: calc(var(--disc) / 2 - 0.3rem);
      border-right: 2px solid var(--jw-line-strong); border-bottom: 0; border-top: 2px solid var(--jw-line-strong);
    }
  }

  /* The one moment: the path draws itself once. Stop i lands at i × 0.55 s; the line after it grows
     over the next 0.45 s, and its arrow shows as the line arrives. */
  .path.waiting .disc { opacity: 0; transform: scale(0.6); }
  .path.waiting .stop::before { transform: scale(0); }
  .path.waiting .stop::after { opacity: 0; }
  @media (min-width: 52rem) {
    .path.waiting .stop::before { transform: scaleX(0); }
  }
  @media (max-width: 51.99rem) {
    .path.waiting .stop::before { transform: scaleY(0); }
  }
  .path.drawn .disc {
    opacity: 1; transform: none;
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(var(--i) * 0.55s);
  }
  .path.drawn .stop::before {
    transform: none;
    transition: transform 0.45s ease-in-out; transition-delay: calc(var(--i) * 0.55s + 0.15s);
  }
  .path.drawn .stop::after {
    opacity: 1;
    transition: opacity 0.15s ease; transition-delay: calc(var(--i) * 0.55s + 0.5s);
  }
</style>
