---
// The featured lessons as cards (dl-5ssh.4.3, redrawn in design handoff "landing 3", dl-5ssh.4.13):
// the subject and grade with the question count, the title, an illustration slot, the first question
// on exercise-book paper, and one link to play in the app with no login. With `row`, the landing page's
// version: the heading and one row of 300 px cards with every featured lesson, in the featured order
// (grade 1 first), drifting sideways by itself and scrolled by hand. No grade tabs, no subject filter
// (dl-5ssh.4.42), no count and no arrows (owner, 2026-11-02, dl-5ssh.4.44). Without `row`, a still
// grid (/lekcje). Only the real featured lessons show (owner, 2026-11-01).
import type { Language } from "@jadwigo/config";
import type { FeaturedLesson } from "@jadwigo/contracts";
import { assertLanguage, playUrl } from "../lib/featured.ts";
import { withLang } from "../lib/i18n.ts";
import { cardArt } from "../lib/illustrations.ts";
import { firstSentence, plural } from "../lib/landing.ts";
import { landingWords } from "../lib/words.ts";
import Pic from "./Pic.astro";

interface Props {
  lang: Language;
  // The page's lessons, from pageLessons(lang) in src/lib/featured.ts.
  lessons: FeaturedLesson[];
  row?: boolean;
}

// The cards, their labels and the lessons are all in the page's language (dl-w0b4.85): a lesson in
// another language stops the build. Each card opens the app in the page's language.
const { lang, lessons, row = false } = Astro.props;
assertLanguage(lessons, lang);
const words = (await landingWords(lang)).lessons;

const cards = lessons.map((l) => {
  const art = cardArt(l);
  return {
    href: withLang(playUrl(l), lang),
    title: l.title,
    // The lesson's picture and its words, or the grey slot naming the lesson.
    pic: art
      ? { src: art.src, label: words.row.pics[art.alt] }
      : { src: undefined, label: `${words.row.pic} · ${l.title}` },
    grade: l.grade === null ? "" : String(l.grade),
    teaser: l.first_say === null ? null : firstSentence(l.first_say),
    meta: [words.subjects[l.subject], l.grade === null ? null : `${words.grade} ${l.grade}`]
      .filter((m): m is string => m !== null)
      .join(" · "),
    count: l.question_count > 0 ? plural(l.question_count, words.questions, lang) : null,
  };
});
---

<div class:list={["lessons-ui", { row }]}>
  {
    row && (
      <div class="wrap controls">
        <div class="head">
          <slot />
        </div>
      </div>
    )
  }
  <ul class="cards">
    {
      cards.map((c) => (
        <li class="card" data-audience="kid" data-grade={c.grade}>
          <a href={c.href}>
            <span class="meta">
              <span>{c.meta}</span>
              {c.count && <span>{c.count}</span>}
            </span>
            <span class="title">{c.title}</span>
            <Pic label={c.pic.label} src={c.pic.src} sizes="17rem" class="card-pic" />
            {c.teaser ? <span class="teaser paper">{c.teaser}</span> : <span class="teaser-none" />}
            <span class="go">{words.play} →</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { track } from "@jadwigo/analytics";
  import { pageLocale } from "../lib/page-locale.ts";

  // The landing page's row (dl-5ssh.4.44): it drifts on its own, slowly and without end, so every
  // lesson passes by. A copy of the cards follows the real ones (out of the tab order and hidden
  // from a screen reader), and the row steps back by one set as it reaches the copy, which looks the
  // same. It rests while the pointer is on it or a card has focus, for a few seconds after a touch or
  // a wheel, while the row is off screen or the tab is hidden; under reduced motion it never moves.
  const SPEED = 22; // px a second
  const REST = 4000; // ms after a touch or a wheel
  for (const ui of document.querySelectorAll<HTMLElement>(".lessons-ui.row")) {
    const list = ui.querySelector<HTMLElement>(".cards");
    const cards = [...ui.querySelectorAll<HTMLElement>(".card")];
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!list || cards.length === 0) continue;

    // A featured lesson opened from the row (dl-w0b4.14), from a card or from its drifting copy below.
    const opened = (card: HTMLElement) =>
      card.querySelector("a")?.addEventListener("click", () =>
        track("featured_lesson_opened", { locale: pageLocale() }),
      );
    for (const card of cards) opened(card);

    // Under reduced motion the row stays still; a hand scrolls it.
    if (still) continue;

    for (const card of cards) {
      const copy = card.cloneNode(true) as HTMLElement;
      // Hidden from a screen reader and out of the tab order, but not inert: an inert card gets no
      // hover, and a pointer on a copy should look and click like the real one (dl-5ssh.4.52).
      copy.setAttribute("aria-hidden", "true");
      for (const link of copy.querySelectorAll("a")) link.tabIndex = -1;
      opened(copy);
      // A copied picture that is already in shows at once; one still on its way fades in when it lands.
      for (const slot of copy.querySelectorAll(".fade-in")) {
        const img = slot.querySelector("img");
        if (img?.complete && img.naturalWidth > 0) slot.classList.add("ready");
      }
      list.append(copy);
    }
    list.classList.add("drifting");
    // One set of cards, from the first card to its copy.
    const span = () => (list.children[cards.length] as HTMLElement).offsetLeft - cards[0]!.offsetLeft;

    let pos = list.scrollLeft;
    let last = performance.now();
    let restUntil = 0;
    let hovered = false;
    let focused = false;
    let seen = true;
    const rest = () => {
      restUntil = performance.now() + REST;
    };
    const wrap = () => {
      const s = span();
      if (s <= 0) return;
      if (pos >= s) pos -= s;
      if (pos < 0) pos += s;
    };
    const tick = (now: number) => {
      const dt = Math.min(64, now - last);
      last = now;
      // A hand on the row (a swipe, a wheel) takes over; the drift goes on from where it left.
      if (Math.abs(list.scrollLeft - pos) > 2) pos = list.scrollLeft;
      if (!hovered && !focused && seen && !document.hidden && now > restUntil) {
        pos += (SPEED * dt) / 1000;
        wrap();
        list.scrollLeft = pos;
      } else if (list.scrollLeft >= span()) {
        pos = list.scrollLeft - span();
        list.scrollLeft = pos;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    list.addEventListener("pointerenter", () => {
      hovered = true;
    });
    list.addEventListener("pointerleave", () => {
      hovered = false;
    });
    list.addEventListener("focusin", () => {
      focused = true;
    });
    list.addEventListener("focusout", () => {
      focused = false;
    });
    list.addEventListener("touchstart", rest, { passive: true });
    list.addEventListener("wheel", rest, { passive: true });
    new IntersectionObserver((entries) => {
      seen = entries.some((e) => e.isIntersecting);
    }).observe(list);

  }
</script>

<style>
  /* The row's heading. */
  .controls { display: grid; gap: 1rem 1.5rem; }

  /* Every card's 5 parts (meta, title, picture, teaser, link) sit on shared rows (subgrid), so the
     pictures and the teasers line up across the cards (owner, 2026-11-02, dl-5ssh.4.44). */
  .cards {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18.75rem), 1fr)); gap: 1.25rem;
    list-style: none; margin: 1.5rem 0 0; padding: 0 0 1rem;
  }
  .card { display: grid; grid-row: span 5; grid-template-rows: subgrid; }
  /* The row: one line of 300 px cards from the page's left margin to its right edge, snapping to a card. */
  .row .cards {
    --edge: max(1rem, calc((100vw - 72rem) / 2 + 1rem));
    display: grid; grid-auto-flow: column; grid-auto-columns: 18.75rem; grid-template-columns: none;
    grid-template-rows: repeat(5, auto); row-gap: 0;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge);
    margin-top: 1.25rem; padding: 0.25rem var(--edge) 1.25rem;
    width: 100vw; margin-left: calc(50% - 50vw);
  }
  .row .card { scroll-snap-align: start; }
  /* While the row drifts by itself, snapping would hold it still. */
  .row .cards.drifting { scroll-snap-type: none; scrollbar-width: none; }
  .row .cards.drifting::-webkit-scrollbar { display: none; }

  .card a {
    display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0.75rem; padding: 1rem;
    border: 2px solid var(--jw-line); border-radius: var(--jw-radius-card);
    background: var(--jw-card); color: var(--jw-ink); text-decoration: none;
    box-shadow: 0 5px 0 var(--jw-line); transition: border-color 120ms;
  }
  .card a:hover { border-color: var(--jw-ink); }
  .card a:focus-visible { outline: 3px solid var(--jw-focus); outline-offset: 3px; }
  .meta { display: flex; justify-content: space-between; gap: 0.75rem; font-size: 0.85rem; font-weight: 700; color: var(--jw-ink-soft); }
  .title { font-size: 1.3rem; font-weight: 700; line-height: 1.25; }
  .card a :global(.card-pic) { height: 6.5rem; min-height: 0; }
  /* The teaser: the first question as the child sees it, on exercise-book paper. */
  /* Its words sit in the middle of the box, top to bottom, whatever its height on the shared row
     (owner, 2026-11-02, dl-5ssh.4.52). */
  .teaser { --cell: 1.25rem; display: flex; align-items: center; padding: 0.6rem 0.75rem; font-size: 1.05rem; font-weight: 700; line-height: 1.35; border-radius: var(--jw-radius-small); }
  /* Play: centred at the card's foot, shown when the card is pointed at or focused; where there is no
     hover (a touch screen) it always shows. Its place is kept, so nothing moves when it appears. */
  .go {
    align-self: end; justify-self: center; padding-top: 0.25rem; font-weight: 700; color: var(--jw-brand-go);
    opacity: 0; transition: opacity 160ms ease;
  }
  .card a:hover .go, .card a:focus-visible .go { opacity: 1; }
  @media (hover: none) { .go { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .go { transition: none; } }
</style>
