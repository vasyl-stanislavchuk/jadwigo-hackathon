---
// The featured lessons as cards (dl-5ssh.4.3, redrawn in design handoff "landing 3", dl-5ssh.4.13):
// the subject and grade with the question count, the title, an illustration slot, the first question
// on squared paper, and one link to play in the app with no login. With `row`, the landing page's
// version: a tab per grade present ("Klasa 1 · 2 · 3", the lowest chosen, dl-w0b4.108), a subject
// filter only while there is more than one subject, a count, and one row of 300 px cards that
// scrolls sideways with snap to the page's right edge, moved a card at a time by 2 arrow buttons.
// While no lesson has a grade there are no tabs and every card shows; once one has, a lesson with
// no grade is left off the row (it stays on /lekcje). Without `row`, a still grid (/lekcje). Only
// the real featured lessons show (owner, 2026-11-01).
import type { Language } from "@jadwigo/config";
import type { FeaturedLesson } from "@jadwigo/contracts";
import { assertLanguage, gradesOf, playUrl } from "../lib/featured.ts";
import { withLang } from "../lib/i18n.ts";
import { firstSentence, plural } from "../lib/landing.ts";
import { landingWords } from "../lib/words.ts";
import Pic from "./Pic.astro";
import Segmented from "./Segmented.astro";

interface Props {
  lang: Language;
  // The page's lessons, from pageLessons(lang) in src/lib/featured.ts.
  lessons: FeaturedLesson[];
  row?: boolean;
}

// The cards, their labels and the lessons are all in the page's language (dl-w0b4.85): a lesson in
// another language stops the build. Each card opens the app in the page's language.
const { lang, lessons, row = false } = Astro.props;
assertLanguage(lessons, lang);
const words = (await landingWords(lang)).lessons;

const grades = row ? gradesOf(lessons) : [];
const first = grades[0];
const onRow = first === undefined ? lessons : lessons.filter((l) => l.grade !== null);
const cards = onRow.map((l) => ({
  href: withLang(playUrl(l), lang),
  title: l.title,
  subject: l.subject,
  grade: l.grade === null ? "" : String(l.grade),
  // Before the script runs, the row shows the lowest grade's tab.
  hidden: first !== undefined && l.grade !== first,
  teaser: l.first_say === null ? null : firstSentence(l.first_say),
  meta: [words.subjects[l.subject], l.grade === null ? null : `${words.grade} ${l.grade}`]
    .filter((m): m is string => m !== null)
    .join(" · "),
  count: l.question_count > 0 ? plural(l.question_count, words.questions, lang) : null,
}));
const subjects = [...new Set(onRow.map((l) => l.subject))];
const gradeOptions = grades.map((g) => ({
  value: String(g),
  label: `${words.row.gradeLabel} ${g}`,
}));
const subjectOptions = [
  { value: "all", label: words.row.allSubjects },
  ...subjects.map((s) => ({ value: s, label: words.subjects[s] })),
];
const shownCount = cards.filter((c) => !c.hidden).length;
---

<div class:list={["lessons-ui", { row }]} data-count={JSON.stringify(words.row.count)} data-lang={lang}>
  {
    row && (
      <div class="wrap controls">
        <div class="head">
          <slot />
        </div>
        <div class="filters">
          {first !== undefined && (
            <Segmented name="grade" label={words.row.gradeLabel} options={gradeOptions} value={String(first)} hideLabel />
          )}
          {subjects.length > 1 && (
            <Segmented name="subject" label={words.row.subjectLabel} options={subjectOptions} value="all" />
          )}
        </div>
        <div class="bar">
          <p class="count" aria-live="polite">{plural(shownCount, words.row.count, lang)}</p>
          <button type="button" class="arrow" data-step="-1" aria-label={words.row.prev}>←</button>
          <button type="button" class="arrow" data-step="1" aria-label={words.row.next}>→</button>
        </div>
      </div>
    )
  }
  <ul class="cards">
    {
      cards.map((c) => (
        <li class="card" data-grade={c.grade} data-subject={c.subject} hidden={c.hidden}>
          <a href={c.href}>
            <span class="meta">
              <span>{c.meta}</span>
              {c.count && <span>{c.count}</span>}
            </span>
            <span class="title">{c.title}</span>
            <Pic label={`${words.row.pic} · ${c.title}`} class="card-pic" />
            {c.teaser && <span class="teaser paper">{c.teaser}</span>}
            <span class="go">{words.play} →</span>
          </a>
        </li>
      ))
    }
  </ul>
  {row && <p class="wrap none" hidden>{words.row.none}</p>}
</div>

<script>
  import { plural } from "../lib/landing.ts";

  for (const ui of document.querySelectorAll<HTMLElement>(".lessons-ui.row")) {
    const list = ui.querySelector<HTMLElement>(".cards");
    const cards = [...ui.querySelectorAll<HTMLElement>(".card")];
    const count = ui.querySelector(".count");
    const none = ui.querySelector<HTMLElement>(".none");
    const arrows = [...ui.querySelectorAll<HTMLButtonElement>(".arrow")];
    const forms = JSON.parse(ui.dataset["count"] ?? "[]") as [string, string, string];
    const lang = ui.dataset["lang"] === "en" ? "en" : "pl";
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!list) continue;

    // The arrows go grey at either end of the row.
    const ends = () => {
      const max = list.scrollWidth - list.clientWidth - 1;
      arrows[0]?.toggleAttribute("disabled", list.scrollLeft <= 0);
      arrows[1]?.toggleAttribute("disabled", list.scrollLeft >= max);
    };

    // A tab and the subject filter show the cards that match both choices and put the row back at
    // its start. With no tabs (no lesson has a grade yet) every grade fits.
    const filter = () => {
      const grade = ui.querySelector<HTMLInputElement>('input[name="grade"]:checked')?.value ?? "all";
      const subject = ui.querySelector<HTMLInputElement>('input[name="subject"]:checked')?.value ?? "all";
      let shown = 0;
      for (const card of cards) {
        const fits =
          (grade === "all" || card.dataset["grade"] === grade) &&
          (subject === "all" || card.dataset["subject"] === subject);
        card.hidden = !fits;
        if (fits) shown += 1;
      }
      if (count) count.textContent = plural(shown, forms, lang);
      if (none) none.hidden = shown > 0;
      list.scrollLeft = 0;
      ends();
    };
    for (const input of ui.querySelectorAll("input")) input.addEventListener("change", filter);

    // Each arrow moves the row by one card and its gap.
    for (const arrow of arrows) {
      arrow.addEventListener("click", () => {
        const card = cards.find((c) => !c.hidden);
        const gap = Number.parseFloat(getComputedStyle(list).columnGap) || 0;
        const step = (card?.offsetWidth ?? 300) + gap;
        list.scrollBy({ left: step * Number(arrow.dataset["step"]), behavior: still ? "auto" : "smooth" });
      });
    }
    list.addEventListener("scroll", ends, { passive: true });
    addEventListener("resize", ends);
    ends();
  }
</script>

<style>
  /* The heading, then the filters; on a laptop the filters stand to the heading's right. */
  .controls { display: grid; gap: 1rem 1.5rem; align-items: end; }
  @media (min-width: 60rem) {
    .controls { grid-template-columns: 1fr auto; }
    .bar { grid-column: 1 / -1; }
  }
  .filters { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .bar { display: flex; align-items: center; gap: 0.75rem; }
  .count { flex: 1; font-weight: 700; color: var(--jw-ink-soft); }
  .arrow {
    width: 48px; height: 48px; display: grid; place-items: center; cursor: pointer;
    font: inherit; font-size: 1.3rem; font-weight: 700; color: var(--jw-ink);
    background: var(--jw-card); border: 2px solid var(--jw-line-strong); border-radius: var(--jw-radius-control);
    box-shadow: 0 3px 0 var(--jw-line-strong); transition: transform 80ms, box-shadow 80ms;
  }
  .arrow:not(:disabled):active { transform: translateY(2px); box-shadow: 0 1px 0 var(--jw-line-strong); }
  .arrow:disabled { opacity: 0.4; cursor: default; }
  .arrow:focus-visible { outline: 3px solid var(--jw-focus); outline-offset: 3px; }

  .cards {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18.75rem), 1fr)); gap: 1.25rem;
    list-style: none; margin: 1.5rem 0 0; padding: 0 0 1rem;
  }
  /* The row: one line of 300 px cards from the page's left margin to its right edge, snapping to a card. */
  .row .cards {
    --edge: max(1rem, calc((100vw - 72rem) / 2 + 1rem));
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge);
    margin-top: 1.25rem; padding: 0.25rem var(--edge) 1.25rem;
    width: 100vw; margin-left: calc(50% - 50vw);
  }
  .row .card { flex: 0 0 18.75rem; scroll-snap-align: start; }
  .card[hidden] { display: none; }

  .card a {
    display: flex; flex-direction: column; gap: 0.75rem; height: 100%; padding: 1rem;
    border: 2px solid var(--jw-line); border-radius: var(--jw-radius-card);
    background: var(--jw-card); color: var(--jw-ink); text-decoration: none;
    box-shadow: 0 5px 0 var(--jw-line); transition: border-color 120ms;
  }
  .card a:hover { border-color: var(--jw-ink); }
  .card a:focus-visible { outline: 3px solid var(--jw-focus); outline-offset: 3px; }
  .meta { display: flex; justify-content: space-between; gap: 0.75rem; font-size: 0.85rem; font-weight: 700; color: var(--jw-ink-soft); }
  .title { font-size: 1.3rem; font-weight: 700; line-height: 1.25; }
  .card a :global(.card-pic) { height: 6.5rem; min-height: 0; }
  /* The teaser: the first question as the child sees it, on squared paper. */
  .teaser { --cell: 1.25rem; padding: 0.6rem 0.75rem; font-size: 1.05rem; font-weight: 700; line-height: 1.35; border-radius: var(--jw-radius-small); }
  .go { margin-top: auto; padding-top: 0.5rem; font-weight: 700; color: var(--jw-brand-go); }
  .none { margin-top: 0.5rem; font-weight: 700; color: var(--jw-ink-soft); }
  .none[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .arrow { transition: none; } }
</style>
