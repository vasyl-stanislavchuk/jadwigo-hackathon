---
// The featured lessons as big cards (dl-5ssh.4.3, dl-5ssh.4.7): who a lesson fits and how long it is
// on top, its first question written large on a notebook page as the teaser, one click to play in
// the app with no login. A still grid: the drifting row went with dl-5ssh.4.9, since the hero holds
// the page's one moving moment.
import type { Language } from "@jadwigo/config";
import { featuredLessons, playUrl } from "../lib/featured.ts";
import { withLang } from "../lib/i18n.ts";
import { firstSentence, plural } from "../lib/landing.ts";
import { landingWords } from "../lib/words.ts";

interface Props {
  lang: Language;
}

// The card labels are in the page's language; the lessons themselves are the featured list's until
// dl-w0b4.85 gives each language its own, and each card opens the app in the page's language.
const { lang } = Astro.props;
const words = (await landingWords(lang)).lessons;
const { lessons, from } = await featuredLessons();
console.warn(`Featured lessons for the gallery: ${lessons.length}, from the ${from}`);

const cards = lessons.map((l) => ({
  href: withLang(playUrl(l), lang),
  title: l.title,
  teaser: l.first_say === null ? null : firstSentence(l.first_say),
  meta: [
    words.subjects[l.subject],
    l.grade === null ? null : `${words.grade} ${l.grade}`,
    l.question_count > 0 ? plural(l.question_count, words.questions, lang) : null,
  ].filter((m): m is string => m !== null),
}));
---

<ul class="gallery">
  {
    cards.map((c) => (
      <li class="card">
        <a href={c.href}>
          <span class="meta">
            {c.meta.map((m) => (
              <span class="chip">{m}</span>
            ))}
          </span>
          {c.teaser && <span class="page">{c.teaser}</span>}
          <span class="foot">
            <span class="title">{c.title}</span>
            <span class="go">{words.play} →</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: 1.25rem;
    list-style: none; margin: 1.5rem 0 0; padding: 0 0 1.25rem;
  }

  .card a {
    display: flex; flex-direction: column; gap: 1rem; height: 100%;
    min-height: 22rem; padding: 1.25rem;
    border: 2px solid var(--jw-line); border-radius: var(--jw-radius-card);
    background: var(--jw-card); color: var(--jw-ink); text-decoration: none;
    box-shadow: 0 6px 0 var(--jw-line); transition: transform 120ms, border-color 120ms;
  }
  .card a:hover { border-color: var(--jw-pick-edge); transform: translateY(-3px); }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    padding: 0.25rem 0.75rem; border-radius: var(--jw-radius-chip); font-size: 0.95rem; font-weight: 700;
    background: var(--jw-pick); color: var(--jw-pick-ink);
  }
  .chip + .chip { background: var(--jw-act-quiet); color: var(--jw-ink); }
  /* The teaser: the first question as the child sees it, large, on a lined exercise-book page. */
  .page {
    flex: 1; display: flex; align-items: center; padding: 1rem 1.25rem; border-radius: var(--jw-radius-small);
    font-size: 1.6rem; font-weight: 700; line-height: 2.2rem; color: var(--jw-ink);
    background: repeating-linear-gradient(to bottom, transparent 0 calc(2.2rem - 1px), var(--jw-line) calc(2.2rem - 1px) 2.2rem),
      var(--jw-act-quiet);
  }
  .foot { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .title { font-size: 1.15rem; font-weight: 700; line-height: 1.3; }
  .go { flex: none; font-weight: 700; color: var(--jw-brand-go); }
</style>
