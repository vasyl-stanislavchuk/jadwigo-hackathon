---
// The hero's one question (dl-5ssh.4.9, redrawn in design handoff "landing 3", dl-5ssh.4.13): a grade 3
// word problem on squared notebook paper, answered right here, with its label, an illustration slot and
// its source. A wrong tile turns the help yellow and shows the hint so the child tries again, never a
// bare "wrong". A right tile turns green with the right line, Jadwiga's clip plays over the sheet as it
// does in the app (apps/web/src/play/Queen.tsx), and then the sheet turns over to the invitation to a
// parent account, with a quiet link that turns it back. Under reduced motion there is no clip and no
// fade: the invitation shows at once. Grading a fixed choose question is a string compare, so the site
// needs no @jadwigo/core. Without JS the tiles stay disabled and the sheet is a teaser.
import type { Language } from "@jadwigo/config";
import queenMov from "@jadwigo/ui/brand/queen.mov";
import queenWebm from "@jadwigo/ui/brand/queen.webm";
import { twinPath } from "../lib/i18n.ts";
import { landingWords } from "../lib/words.ts";
import Pic from "./Pic.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const q = (await landingWords(lang)).hero.question;
---

<div class="sheet paper" data-answer={q.answer} data-right={q.right} data-hint={q.hint}>
  <div class="face ask">
    <p class="label">{q.label}</p>
    <div class="q">
      <p class="say" id="hero-say">{q.say}</p>
      <Pic label={q.pic} class="hero-pic" />
    </div>
    <div class="tiles" role="group" aria-labelledby="hero-say">
      {q.choices.map((c) => <button type="button" class="tile" disabled>{c}</button>)}
    </div>
    <p class="said" aria-live="polite"></p>
    <p class="source">{q.source}</p>
  </div>
  <div class="face join" hidden>
    <p class="pitch">{q.signUp.text}</p>
    <a class="btn" href={`${twinPath("signIn", lang)}/`}>{q.signUp.button}</a>
    <button type="button" class="again">{q.signUp.again}</button>
  </div>
  <video class="queen" aria-hidden="true" muted playsinline preload="none" hidden>
    <source src={queenMov} type='video/mp4; codecs="hvc1"' />
    <source src={queenWebm} type="video/webm" />
  </video>
</div>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const sheet of document.querySelectorAll<HTMLElement>(".sheet")) {
    const said = sheet.querySelector<HTMLElement>(".ask .said");
    const join = sheet.querySelector<HTMLElement>(".join");
    const video = sheet.querySelector("video");
    const tiles = [...sheet.querySelectorAll<HTMLButtonElement>(".tile")];

    // The clip loads only once a visitor reaches for a tile, so the page itself stays light.
    const warm = () => {
      if (video) video.preload = "auto";
    };
    sheet.addEventListener("pointerover", warm, { once: true });
    sheet.addEventListener("focusin", warm, { once: true });

    // The clip's end, a load error, a refused autoplay, a tap or 6 s, whichever is first, turns the
    // sheet over. The invitation takes the focus so a keyboard lands on its button.
    let turned = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const turn = () => {
      if (turned || !join) return;
      turned = true;
      clearTimeout(timer);
      document.removeEventListener("pointerdown", turn);
      if (video) {
        video.pause();
        video.hidden = true;
      }
      join.hidden = false;
      join.getBoundingClientRect(); // a layout first, so the fade starts from the hidden face
      sheet.classList.add("turned");
      join.querySelector("a")?.focus({ preventScroll: true });
    };

    const celebrate = () => {
      if (still || !video) {
        timer = setTimeout(turn, still ? 0 : 1800);
        return;
      }
      video.currentTime = 0;
      video.hidden = false;
      video.addEventListener("ended", turn, { once: true });
      video.addEventListener("error", turn, { once: true });
      video.play().catch(turn);
      timer = setTimeout(turn, 6000);
      // The tap that answered has already passed, so the next one turns the sheet.
      setTimeout(() => document.addEventListener("pointerdown", turn), 0);
    };

    // "Play the question again": the question as it was, the focus on its first tile.
    const reset = () => {
      turned = false;
      sheet.classList.remove("turned", "done");
      if (join) join.hidden = true;
      if (said) {
        said.textContent = "";
        said.className = "said";
      }
      for (const t of tiles) {
        t.disabled = false;
        t.classList.remove("right", "miss");
      }
      tiles[0]?.focus({ preventScroll: true });
    };
    sheet.querySelector(".again")?.addEventListener("click", reset);

    for (const tile of tiles) {
      tile.disabled = false;
      tile.addEventListener("click", () => {
        const right = tile.textContent === sheet.dataset["answer"];
        for (const t of tiles) t.classList.remove("miss");
        tile.classList.add(right ? "right" : "miss");
        if (said) {
          said.textContent = (right ? sheet.dataset["right"] : sheet.dataset["hint"]) ?? "";
          said.className = `said ${right ? "right" : "hint"}`;
        }
        if (!right) return;
        sheet.classList.add("done");
        for (const t of tiles) t.disabled = true;
        celebrate();
      });
    }
  }
</script>

<style>
  /* Both faces share one grid cell, so turning over never changes the sheet's height. */
  .sheet {
    position: relative; display: grid; padding: var(--cell) calc(var(--cell) * 1);
    box-shadow: 0 6px 0 var(--jw-line);
  }
  @media (min-width: 52rem) { .sheet { padding: calc(var(--cell) * 1.25) calc(var(--cell) * 1.5); } }
  .face { grid-area: 1 / 1; display: flex; flex-direction: column; }
  .label { font-size: 0.9rem; font-weight: 700; color: var(--jw-ink-soft); }
  .q { display: grid; gap: var(--cell); margin-top: calc(var(--cell) / 2); }
  .say { font-size: clamp(1.4rem, 2.6vw, 1.75rem); font-weight: 700; line-height: 1.3; }
  .q :global(.hero-pic) { min-height: 8rem; }
  @media (min-width: 36rem) {
    .q { grid-template-columns: 1fr 9.5rem; align-items: center; }
    .q :global(.hero-pic) { height: 8.25rem; }
  }
  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-top: var(--cell); }
  .tile {
    min-height: 3.25rem; padding: 0 0.5rem;
    font: inherit; font-size: 1.5rem; font-weight: 700; color: var(--jw-ink); cursor: pointer;
    font-variant-numeric: tabular-nums;
    background: var(--jw-card); border: 2px solid var(--jw-line-strong); border-radius: var(--jw-radius-control);
    box-shadow: 0 4px 0 var(--jw-line-strong);
    transition: background-color 150ms, border-color 150ms, transform 80ms, box-shadow 80ms;
  }
  .tile:disabled { cursor: default; }
  .tile:not(:disabled):active { transform: translateY(3px); box-shadow: 0 1px 0 var(--jw-line-strong); }
  .tile:focus-visible { outline: 3px solid var(--jw-focus); outline-offset: 3px; }
  .tile.right { background: var(--jw-right); border-color: var(--jw-right-edge); color: var(--jw-right-ink); box-shadow: 0 4px 0 var(--jw-right-edge); }
  .tile.miss { background: var(--jw-miss); border-color: var(--jw-miss-edge); color: var(--jw-miss-ink); box-shadow: 0 4px 0 var(--jw-miss-edge); }
  .done .tile:not(.right) { opacity: 0.45; }
  /* The hint in the help colours, the right line in the right colours; empty, it takes no room. */
  .said:empty { display: none; }
  .said {
    margin-top: var(--cell); padding: 0.75rem 1rem; border: 2px solid; border-radius: var(--jw-radius-small);
    font-size: 1.05rem; line-height: 1.45;
  }
  .said.hint { background: var(--jw-help); border-color: var(--jw-help-edge); color: var(--jw-help-ink); }
  .said.right { background: var(--jw-right); border-color: var(--jw-right-edge); color: var(--jw-right-ink); font-weight: 700; }
  .source { margin-top: var(--cell); font-size: 0.85rem; color: var(--jw-ink-soft); }

  /* The invitation, on the same paper: one sentence for the parent, one button, a way back. */
  .join { align-self: center; align-items: flex-start; gap: var(--cell); }
  .pitch { font-size: 1.25rem; font-weight: 700; line-height: 1.4; max-width: 28ch; }
  .again {
    padding: 0.5rem 0; min-height: 44px; border: 0; background: none; cursor: pointer;
    font: inherit; font-size: 0.95rem; color: var(--jw-ink-soft); text-decoration: underline;
  }
  .again:hover { color: var(--jw-ink); }

  /* The turn: the question fades out and lifts away as the invitation rises in, 450 ms. */
  .ask, .join { transition: opacity 450ms ease, translate 450ms ease; }
  .turned .ask { opacity: 0; translate: 0 -0.75rem; visibility: hidden; transition-property: opacity, translate, visibility; }
  .join { opacity: 0; translate: 0 0.75rem; }
  .turned .join { opacity: 1; translate: 0 0; }
  .join[hidden] { display: none; }

  /* Jadwiga stands on the sheet's bottom edge at its right, as she stands on the footer in the app. */
  .queen { position: absolute; right: -1.5rem; bottom: 0; width: min(75%, 22rem); pointer-events: none; z-index: 1; }
  .queen[hidden] { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .tile, .ask, .join { transition: none; }
  }
</style>
