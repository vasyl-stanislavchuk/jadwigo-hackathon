---
// O nas's family photos as slides (dl-w0b4.42). They are served from the site's bucket under
// about-photos/, never from git (make -C infra site-photos). A slide keeps the whole photo, on one
// shape. Swipe and the arrow keys work with no script; the buttons and dots need it, so they start hidden.
import type { Page } from "../lib/seo.ts";

interface Props {
  photos: NonNullable<Page["photos"]>;
  words: NonNullable<Page["slides"]>;
}

const { photos, words } = Astro.props;
const src = (file: string, width: number) => `/about-photos/${file}-${width}.webp`;
---

<section class="slides" aria-roledescription="carousel" aria-label={words.label} data-slides>
  <ul class="track" tabindex="0" aria-label={words.label}>
    {
      photos.map((p, i) => (
        <li class="slide">
          <img
            src={src(p.file, 1280)}
            srcset={`${src(p.file, 640)} 640w, ${src(p.file, 1280)} 1280w`}
            sizes="(max-width: 56rem) 100vw, 36rem"
            alt={p.alt}
            width={p.width}
            height={p.height}
            loading={i === 0 ? "eager" : "lazy"}
          />
        </li>
      ))
    }
  </ul>
  <div class="controls" hidden>
    <button type="button" data-step="-1" aria-label={words.prev}>←</button>
    <span class="dots">
      {photos.map((_, i) => <button type="button" data-go={i} aria-label={`${words.go} ${i + 1}`}></button>)}
    </span>
    <button type="button" data-step="1" aria-label={words.next}>→</button>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-slides]")) {
    const track = root.querySelector<HTMLElement>(".track");
    const controls = root.querySelector<HTMLElement>(".controls");
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-go]")];
    if (!track || !controls) continue;
    controls.hidden = false;
    const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const show = (i: number) => {
      const next = (i + dots.length) % dots.length;
      track.scrollTo({ left: next * track.clientWidth, behavior: smooth ? "smooth" : "auto" });
    };
    const mark = () => {
      const at = current();
      dots.forEach((dot, i) => {
        if (i === at) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };
    for (const button of root.querySelectorAll<HTMLButtonElement>("[data-step]")) {
      button.addEventListener("click", () => show(current() + Number(button.dataset["step"])));
    }
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => show(i));
    });
    track.addEventListener("scroll", mark, { passive: true });
    mark();
  }
</script>

<style>
  .slides { min-width: 0; }
  .track {
    list-style: none; display: flex; margin: 0; padding: 0; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    background: var(--secondary); border-radius: var(--jw-radius-card);
  }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: none; box-shadow: var(--halo); }
  .slide { flex: 0 0 100%; aspect-ratio: 4 / 3; scroll-snap-align: start; }
  .slide img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .controls { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-top: 0.75rem; }
  .controls[hidden] { display: none; }
  [data-step] {
    width: 2.5rem; height: 2.5rem; background: var(--jw-card); border: 1px solid var(--jw-line);
    border-radius: var(--jw-radius-small); color: var(--jw-ink); font: inherit; cursor: pointer;
  }
  [data-step]:hover { background: var(--jw-hover-strong); }
  .dots { display: flex; gap: 0.25rem; }
  [data-go] { width: 1.5rem; height: 2.5rem; padding: 0; background: none; border: 0; cursor: pointer; display: grid; place-items: center; }
  [data-go]::before { content: ""; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--jw-line); }
  [data-go][aria-current]::before { background: var(--jw-ink); }
</style>
