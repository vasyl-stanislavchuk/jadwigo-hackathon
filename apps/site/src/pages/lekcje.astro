---
// /lekcje (dl-5ssh.4.7): every featured lesson as a still grid of big cards.
import { getEntry } from "astro:content";
import Gallery from "../components/Gallery.astro";
import Base from "../layouts/Base.astro";

const words = (await getEntry("landing", "pl"))?.data.lessons;
if (!words) throw new Error("src/content/pl/landing.yaml has no lessons words");
const page = { ...words, reviewed: true };
---

<Base page={page} path="/lekcje">
  <section class="wrap top" aria-labelledby="page-title">
    <h1 id="page-title">{words.heading}</h1>
    <p>{words.text}</p>
    <Gallery />
  </section>
</Base>

<style>
  .top { padding-top: clamp(2rem, 6vw, 3.5rem); }
  h1 { font-size: clamp(2rem, 5vw, 2.75rem); }
  p { margin-top: 0.5rem; color: var(--jw-ink-soft); }
</style>
