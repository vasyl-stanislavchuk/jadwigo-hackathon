---
import type { Language } from "@jadwigo/config";
// The parent's way in on jadwigo.pl (dl-5ssh.4.2): the email code, then Google, then Facebook, the
// order of jadwigo-platform/decisions/2026-10-30-the-parent-sign-in-screen-lists-the-email-code-first-
// then-google. Nothing signs in here: each way hands over to the app's /parent, which reads
// ?email= and ?provider= (apps/web/src/parent/route.ts). Signing in and registering are one step.
// An English page adds lang=en to each, the form as a hidden field (dl-w0b4.81). The Facebook button
// shows only once the Meta app is Live: one switch, facebookSignInLive in src/lib/landing.ts (dl-ovva).
import facebook from "../assets/facebook-f.svg?raw";
import google from "../assets/google-g.svg?raw";
import { parentUrl, providerUrl } from "../index.ts";
import Base from "../layouts/Base.astro";
import { strictBuild } from "../lib/build.ts";
import { otherLanguage, twinPath, twinStaticPaths, withLang } from "../lib/i18n.ts";
import { signInProviders } from "../lib/landing.ts";
import { landingReviewed, landingWords } from "../lib/words.ts";

export const getStaticPaths = () => twinStaticPaths("signIn", strictBuild);

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const words = (await landingWords(lang)).signIn;
const reviewed = await landingReviewed(lang);
const icons = { google, facebook };
const providers = signInProviders();
const translation = twinPath("signIn", otherLanguage(lang));
const page = {
  title: words.title,
  description: words.description,
  heading: words.heading,
  lang,
  reviewed,
  translation,
};
---

<Base page={page} path={twinPath("signIn", lang)}>
  <section class="sign-in wrap" aria-labelledby="sign-in-title">
    <h1 id="sign-in-title">{words.heading}</h1>
    <p class="lead">{words.lead}</p>
    <form action={parentUrl} method="get" class="email">
      <label for="email">{words.email}</label>
      <input id="email" name="email" type="email" autocomplete="email" required />
      {lang !== "pl" && <input type="hidden" name="lang" value={lang} />}
      <button class="btn" type="submit">{words.send}</button>
      <p class="note">{words.note}</p>
    </form>
    <p class="or">{words.or}</p>
    <p class="providers">
      {providers.map((p) => (
        <a class="provider" data-provider={p} href={withLang(providerUrl(p), lang)}><span set:html={icons[p]} />{words[p]}</a>
      ))}
    </p>
  </section>
</Base>

<script>
  import { track } from "@jadwigo/analytics";
  import { pageLocale } from "../lib/page-locale.ts";

  document.querySelector(".email")?.addEventListener("submit", () =>
    track("email_sign_in_submitted", { locale: pageLocale() }),
  );
  for (const provider of document.querySelectorAll<HTMLElement>(".provider")) {
    provider.addEventListener("click", () => {
      const name = provider.dataset["provider"];
      if (name === "google" || name === "facebook")
        track("provider_sign_in_selected", { locale: pageLocale(), provider: name });
    });
  }
</script>

<style>
  /* The adult sign-in scale (handoff §3): body 16, title 28, controls 40. */
  .sign-in { max-width: 26rem; padding-top: clamp(2.5rem, 7vw, 4.5rem); font-size: 1rem; }
  h1 { font-size: var(--jw-page-h1); }
  .lead { margin-top: 0.75rem; color: var(--jw-ink-soft); }
  .email { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 2rem; }
  label { font-weight: 500; }
  input {
    min-height: var(--jw-control-height-lg); padding: 0 0.75rem; font: inherit; color: var(--jw-ink);
    border: 1px solid var(--input); border-radius: var(--jw-radius-control); background: var(--jw-card);
  }
  input:focus-visible { outline: none; border-color: var(--ring); box-shadow: var(--halo); }
  button.btn { border: 0; font: inherit; font-weight: 500; cursor: pointer; }
  .note { font-size: 0.875rem; color: var(--jw-ink-soft); }
  .or { margin: 1.5rem 0 1rem; text-align: center; color: var(--jw-ink-soft); }
  .providers { display: flex; flex-direction: column; gap: 0.75rem; }
  .provider {
    display: flex; align-items: center; justify-content: center; gap: 0.75rem; min-height: var(--jw-control-height-lg);
    border: 1px solid var(--input); border-radius: var(--jw-radius-control);
    color: var(--jw-ink); text-decoration: none; font-weight: 500; background: var(--jw-card);
    transition: background-color 120ms;
  }
  .provider:hover { background: var(--accent); }
  .provider span { display: inline-flex; line-height: 0; }
</style>
