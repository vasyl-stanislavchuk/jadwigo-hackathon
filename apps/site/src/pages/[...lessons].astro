---
import type { Language } from "@jadwigo/config";
// /lekcje and /en/lessons (dl-5ssh.4.7, dl-w0b4.81): every featured lesson as a still grid of big cards.
import Gallery from "../components/Gallery.astro";
import Base from "../layouts/Base.astro";
import { strictBuild } from "../lib/build.ts";
import { pageLessons } from "../lib/featured.ts";
import { otherLanguage, twinPath, twinStaticPaths } from "../lib/i18n.ts";
import { landingReviewed, landingWords } from "../lib/words.ts";

export const getStaticPaths = () => twinStaticPaths("lessons", strictBuild);

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const words = await landingWords(lang);
const reviewed = await landingReviewed(lang);
const translation = twinPath("lessons", otherLanguage(lang));
const page = { ...words.lessons, lang, reviewed, translation };
// Only this language's lessons; with none yet, one line in place of the cards (dl-w0b4.85).
const lessons = await pageLessons(lang);
---

<Base page={page} path={twinPath("lessons", lang)}>
  <section class="wrap top" aria-labelledby="page-title">
    <h1 id="page-title">{words.lessons.heading}</h1>
    {
      lessons.length > 0 ? (
        <>
          <p>{words.lessons.text}</p>
          <Gallery lang={lang} lessons={lessons} />
        </>
      ) : (
        <p>{words.lessons.empty}</p>
      )
    }
  </section>
</Base>

<style>
  .top { padding-top: clamp(2rem, 6vw, 3.5rem); }
  h1 { font-size: clamp(2rem, 5vw, 2.75rem); }
  p { margin-top: 0.5rem; color: var(--jw-ink-soft); }
</style>
