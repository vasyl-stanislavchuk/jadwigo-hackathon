---
import { getEntry } from "astro:content";
// The landing page (dl-5ssh.4.1, dl-5ssh.4.7, dl-5ssh.4.9): the h1 beside one question a visitor can
// answer and no buttons of its own (owner, 2026-10-31: "too many buttons"), the lessons anyone can
// play right away, and one line for the parent. Everything else is its own page in the header. The words are in src/content/<lang>/index.md (head and h1) and
// src/content/<lang>/landing.yaml; the page builds at / and /en (dl-w0b4.81).
import type { Language } from "@jadwigo/config";
import Gallery from "../components/Gallery.astro";
import HeroQuestion from "../components/HeroQuestion.astro";
import Base from "../layouts/Base.astro";
import { strictBuild } from "../lib/build.ts";
import { otherLanguage, twinPath, twinStaticPaths } from "../lib/i18n.ts";
import { landingWords } from "../lib/words.ts";

export const getStaticPaths = () => twinStaticPaths("index", strictBuild);

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const entry = await getEntry("pages", `${lang}/index`);
if (!entry) throw new Error(`src/content/${lang}/index.md is missing`);
const words = await landingWords(lang);
const page = { ...entry.data, translation: twinPath("index", otherLanguage(lang)) };
// The lessons section's anchor, which /praca-domowa links: #lekcje in Polish, #lessons in English.
const lessonsId = lang === "pl" ? "lekcje" : "lessons";
---

<Base page={page} path={twinPath("index", lang)}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <h1 id="hero-title">{entry.data.heading}</h1>
    <HeroQuestion lang={lang} />
  </section>

  <section id={lessonsId} class="lessons wrap" aria-labelledby="lessons-title">
    <h2 id="lessons-title">{words.lessons.heading}</h2>
    <p>{words.lessons.text} <a href={`${twinPath("lessons", lang)}/`}>{words.lessons.all}</a></p>
    <Gallery lang={lang} />
  </section>

  <section class="after wrap">
    <p>{words.after.text} <a href={`${twinPath("howItWorks", lang)}/`}>{words.after.link}</a></p>
  </section>
</Base>

<style>
  /* A phone reads the h1, then the question. From 52rem the h1 stands left and the question right. */
  .hero {
    display: grid; gap: 2rem; align-items: center;
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }
  .hero h1 { max-width: 11ch; font-size: clamp(2.6rem, 7vw, 4.25rem); line-height: 1.05; letter-spacing: -0.015em; }
  @media (min-width: 52rem) {
    .hero { grid-template-columns: 1fr 1.1fr; column-gap: 4rem; }
  }
  .lessons { margin-top: clamp(3.5rem, 9vw, 6rem); }
  .lessons > p { margin-top: 0.5rem; color: var(--jw-ink-soft); }
  .lessons > p a, .after a { font-weight: 700; }
  .after { margin-top: 2.5rem; }
  .after p { font-size: 1.2rem; }
</style>
