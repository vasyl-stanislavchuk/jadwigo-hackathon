---
import { getEntry } from "astro:content";
// The landing page (dl-5ssh.4.1, dl-5ssh.4.7, dl-5ssh.4.9; direction 1a of design handoff "landing 3",
// dl-5ssh.4.13): the h1 beside one question a visitor can answer and no buttons of its own (owner,
// 2026-10-31: "too many buttons"), the lessons anyone can play right away, learning the parent is close
// to beside an example child's profile, what a family gets, and the sign-up. Each header link is its own page. The words are in src/content/<lang>/index.md (head and h1) and
// src/content/<lang>/landing.yaml; the page builds at / and /en (dl-w0b4.81).
import type { Language } from "@jadwigo/config";
import EndBand from "../components/EndBand.astro";
import Gallery from "../components/Gallery.astro";
import HeroQuestion from "../components/HeroQuestion.astro";
import PartnerBlock from "../components/PartnerBlock.astro";
import Base from "../layouts/Base.astro";
import { strictBuild } from "../lib/build.ts";
import { pageLessons } from "../lib/featured.ts";
import { otherLanguage, twinPath, twinStaticPaths } from "../lib/i18n.ts";
import { landingWords } from "../lib/words.ts";

export const getStaticPaths = () => twinStaticPaths("index", strictBuild);

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const entry = await getEntry("pages", `${lang}/index`);
if (!entry) throw new Error(`src/content/${lang}/index.md is missing`);
const words = await landingWords(lang);
const page = { ...entry.data, translation: twinPath("index", otherLanguage(lang)) };
// The lessons section's anchor, which /praca-domowa links: #lekcje in Polish, #lessons in English.
const lessonsId = lang === "pl" ? "lekcje" : "lessons";
// Only this language's lessons; with none yet, one line in place of the cards (dl-w0b4.85).
const lessons = await pageLessons(lang);
---

<Base page={page} path={twinPath("index", lang)}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <h1 id="hero-title">{entry.data.heading}</h1>
    <HeroQuestion lang={lang} />
  </section>

  <section id={lessonsId} class="lessons" aria-labelledby="lessons-title">
    {
      lessons.length > 0 ? (
        <Gallery lang={lang} lessons={lessons} row>
          <h2 id="lessons-title">{words.lessons.row.heading}</h2>
        </Gallery>
      ) : (
        <>
          <h2 id="lessons-title" class="wrap">{words.lessons.row.heading}</h2>
          <p class="wrap">{words.lessons.empty}</p>
        </>
      )
    }
    <p class="after wrap">{words.after.text} <a href={`${twinPath("howItWorks", lang)}/`}>{words.after.link}</a></p>
  </section>

  <div class="band"><PartnerBlock lang={lang} /></div>

  <section class="band promises" aria-labelledby="promises-title">
    <div class="wrap">
      <h2 id="promises-title">{words.promises.heading}</h2>
      <ul>
        {
          words.promises.items.map((i) => (
            <li>
              <h3>{i.title}</h3>
              <p>{i.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <EndBand lang={lang} />
</Base>

<style>
  /* A phone reads the h1, then the question. From 52rem the h1 stands left and the question right. */
  .hero {
    display: grid; gap: 1.5rem; align-items: center;
    padding-top: clamp(1.5rem, 5vw, 3rem);
  }
  .hero h1 { max-width: 15ch; font-size: clamp(2.2rem, 5vw, 3.5rem); line-height: 1.08; letter-spacing: -0.015em; }
  @media (min-width: 52rem) {
    .hero { grid-template-columns: 1fr 1.15fr; column-gap: 3.5rem; }
  }
  .lessons { margin-top: clamp(3rem, 7vw, 4.5rem); }
  .after { margin-top: 0.75rem; }
  .after a { font-weight: 700; }
  /* Each block below the lessons starts on its own line across the page. */
  .band { border-top: 2px solid var(--jw-line); margin-top: clamp(3rem, 7vw, 5rem); padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .promises ul {
    list-style: none; margin: 1.75rem 0 0; padding: 0;
    display: grid; gap: 1.5rem 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .promises h3 { font-size: 1.05rem; }
  .promises p { margin-top: 0.35rem; color: var(--jw-ink-soft); font-size: 0.98rem; }
</style>
