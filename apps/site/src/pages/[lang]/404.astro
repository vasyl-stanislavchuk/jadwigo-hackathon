---
// The 404 for each language under its own prefix: /en/404 once English is served (lib/i18n.ts).
import NotFound from "../../components/NotFound.astro";
import { prefixedLanguages } from "../../lib/i18n.ts";

export function getStaticPaths() {
  return prefixedLanguages(import.meta.env.PROD).map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: ReturnType<typeof prefixedLanguages>[number];
}

const { lang } = Astro.props;
---

<NotFound lang={lang} />
