---
// Every content page that names its own `path`: the privacy pages (dl-w0b4.64) and O nas, which names
// its `photos` and so gets its own layout (dl-5ssh.4.15). The path is
// the page's stable URL, so a link handed to Meta or Google keeps working. A prod build leaves out
// the ones not yet reviewed (servedPathPages) and builds the rest of the site.
import { type CollectionEntry, getCollection, render } from "astro:content";
import { hosts } from "@jadwigo/config";
import wordmark from "@jadwigo/ui/brand/wordmark.svg?raw";
import PhotoCollage from "../components/PhotoCollage.astro";
import Pic from "../components/Pic.astro";
import Base from "../layouts/Base.astro";
import { strictBuild } from "../lib/build.ts";
import { languageOf, servedLanguages } from "../lib/i18n.ts";
import { servedPathPages } from "../lib/seo.ts";

export async function getStaticPaths() {
  // Only the pages in a language the build serves: no English page reaches a strict build before
  // English is live (dl-w0b4.81).
  const languages = servedLanguages(strictBuild);
  const all = (await getCollection("pages")).filter((p) => languages.includes(languageOf(p.data)));
  const pages = servedPathPages(all, strictBuild);
  return pages.map((entry) => ({ params: { path: entry.data.path?.slice(1) }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { photos, photosLabel, video, link, heading } = entry.data;
const docsHost = hosts.prod.docs;
// In O nas's words, the name is the wordmark itself, and its crown tips on hover as it does in the header.
const story = (entry.rendered?.html ?? "").replace(
  /\bJadwigo\b/g,
  `<span class="word-logo">${wordmark}</span>`,
);
---

{
  photos && photosLabel ? (
    <Base page={entry.data} path={entry.data.path ?? "/"}>
      <section class="about wrap">
        <div class="words">
          <h1>{heading}</h1>
          <Fragment set:html={story} />
          {link && <a class="link" href={`${link.href}/`}>{link.label}</a>}
        </div>
        <PhotoCollage photos={photos} label={photosLabel} />
      </section>
      {video && (
        <section class="film wrap" aria-labelledby="film-title">
          <h2 id="film-title">{video.heading}</h2>
          {video.file ? (
            <video class="player" controls preload="metadata" playsinline src={`/about-photos/${video.file}`} poster="/about-photos/film-poster.webp" aria-label={video.heading}></video>
          ) : (
            <Pic label={video.label} screen ratio="16 / 9" class="player" />
          )}
          <p>{video.docs} <a href={`https://${docsHost}/`}>{docsHost}</a></p>
        </section>
      )}
    </Base>
  ) : (
    <Base page={entry.data} path={entry.data.path ?? "/"} prose>
      <Content />
    </Base>
  )
}

<style is:global>
  /* O nas (design handoff "landing 3", dl-5ssh.4.15): the words on the left, the photo collage on the
     right. A phone reads the words, then the collage. Global under .about,
     so the h1 stays a bare <h1>, as check:dist reads it (src/lib/dist.ts). */
  .about.wrap { padding-top: clamp(2rem, 5vw, 4rem); overflow-x: clip; }
  .about { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
  @media (min-width: 56rem) { .about { grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start; } }
  .about h1 { font-size: clamp(2.2rem, 5vw, 3.25rem); }
  .about .words { max-width: 34rem; }
  .about .words p { margin-top: 1rem; font-size: 1.125rem; line-height: 1.6; }
  /* The first paragraph is the page's lead. */
  .about .words p:first-of-type { font-size: 1.35rem; font-weight: 500; line-height: 1.45; }
  /* The wordmark sits on the text's baseline at the letters' size. Its box is 180 units tall with the
     crown's room, the letters stand 72 tall on a baseline 24 above its bottom. The negative margin keeps
     that room out of the line's height. */
  .about .word-logo { rotate: -4deg; display: inline-block; margin: -0.6em -0.05em 0; line-height: 0; vertical-align: -0.233em; }
  .about .word-logo svg { display: block; height: 1.75em; width: auto; overflow: visible; }
  .about .word-logo .crown { transform-origin: -12.5px 2.15px; transition: transform 320ms cubic-bezier(.34, 1.8, .5, 1); }
  .about .word-logo:hover .crown { transform: translateY(-12.5px) rotate(-18deg); }
  @media (prefers-reduced-motion: reduce) {
    .about .word-logo .crown, .about .word-logo:hover .crown { transition: none; transform: none; }
  }
  .film { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .film h2 { font-size: 1.75rem; }
  .film .player { display: block; width: 100%; max-width: 48rem; margin-top: 1rem; border-radius: var(--jw-radius-card); }
  .film p { margin-top: 1rem; font-size: 1.125rem; }
  .about .link { display: inline-block; margin-top: 1.5rem; font-weight: 700; }
</style>
