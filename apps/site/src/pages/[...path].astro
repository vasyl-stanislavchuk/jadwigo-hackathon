---
// Every content page that names its own `path`: the privacy pages today (dl-w0b4.64). The path is
// the page's stable URL, so a link handed to Meta or Google keeps working.
import { type CollectionEntry, getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.flatMap((entry) =>
    entry.data.path ? [{ params: { path: entry.data.path.slice(1) }, props: { entry } }] : [],
  );
}

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base page={entry.data} path={entry.data.path ?? "/"} prose>
  <Content />
</Base>
