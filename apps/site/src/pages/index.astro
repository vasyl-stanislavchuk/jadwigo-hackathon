---
// The landing page (dl-5ssh.4.1, dl-5ssh.4.7): one line for the parent, the homework button, and
// the lessons anyone can play right away, big. Everything else is its own page in the header. The
// words are in src/content/pl/index.md (head and h1) and src/content/pl/landing.yaml.
import { getEntry } from "astro:content";
import Gallery from "../components/Gallery.astro";
import Base from "../layouts/Base.astro";

const entry = await getEntry("pages", "pl/index");
const words = (await getEntry("landing", "pl"))?.data;
if (!entry || !words) throw new Error("src/content/pl/index.md or landing.yaml is missing");
---

<Base page={entry.data} path="/">
  <section class="hero wrap" aria-labelledby="hero-title">
    <h1 id="hero-title">{entry.data.heading}</h1>
    <p class="lead">{words.hero.lead}</p>
    <p class="actions">
      <a class="btn" href="/praca-domowa/">{words.hero.homework}</a>
      <a class="btn quiet" href="#lekcje">{words.hero.play}</a>
    </p>
  </section>

  <section id="lekcje" class="lessons" aria-labelledby="lessons-title">
    <div class="wrap">
      <h2 id="lessons-title">{words.lessons.heading}</h2>
      <p>{words.lessons.text} <a href="/lekcje/">{words.lessons.all} →</a></p>
    </div>
    <Gallery />
  </section>
</Base>

<style>
  .hero { padding-top: clamp(2.5rem, 7vw, 4.5rem); max-width: 44rem; margin: 0 auto; text-align: center; }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 3.5rem); letter-spacing: -0.01em; }
  .lead { font-size: clamp(1.15rem, 2.6vw, 1.4rem); margin-top: 1rem; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: 1.75rem; }
  .lessons { margin-top: clamp(3rem, 8vw, 4.5rem); }
  .lessons p { margin-top: 0.5rem; color: var(--jw-ink-soft); }
  .lessons p a { font-weight: 700; }
</style>
