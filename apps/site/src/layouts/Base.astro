---
// Every page's frame: Polish, the head from lib/seo.ts, Zeszyt's tokens and Andika, a header with the
// crown wordmark (decision jadwigo-marketing/decisions/2026-10-30-jadwigo-wears-lockup-4a-an-andika-
// wordmark-with-a-crown-tipped-o) and a footer. With `prose`, the words read top to bottom in a
// column under the page's heading, as the privacy pages do (dl-w0b4.64). Without it, the page brings
// its own sections and its own h1 (the landing page, dl-5ssh.4.1). The header links every page in
// landing.yaml's `links`, each its own page (owner, 2026-10-31). The frame's own words (the logo's
// and the nav's labels, the sign-in, the footer, the other language's name) are the site_* Paraglide
// messages in the page's language (dl-w0b4.82). The header's switch links the page's twin in the
// other language, when the build serves it (dl-w0b4.81). The header, burger and footer follow design
// handoff "landing 3" (dl-5ssh.4.12).
import "@fontsource/andika/400.css";
import "@fontsource/andika/700.css";
import "@jadwigo/ui/foundation.css";
import { getCollection, getEntry } from "astro:content";
import { m } from "@jadwigo/copy/messages";
import wordmark from "@jadwigo/ui/brand/wordmark.svg?raw";
import LanguageNote from "../components/LanguageNote.astro";
import Segmented from "../components/Segmented.astro";
import { strictBuild } from "../lib/build.ts";
import {
  footerPaths,
  languageOf,
  otherLanguage,
  servedLanguages,
  servedTwinPaths,
  twinPath,
} from "../lib/i18n.ts";
import {
  assertReviewed,
  headTags,
  jsonLd,
  type Page,
  servedPathPages,
  xDefaultTag,
} from "../lib/seo.ts";

interface Props {
  page: Page;
  path: string;
  prose?: boolean;
}

const { page, path, prose = false } = Astro.props;
const lang = languageOf(page);
const other = otherLanguage(lang);
const locale = { locale: lang } as const;
const languages = servedLanguages(strictBuild);
// Only the pages of the languages this build serves count: an English draft holds back no Polish build.
const pages = (await getCollection("pages")).filter((p) => languages.includes(languageOf(p.data)));
assertReviewed(pages, strictBuild);
const landing = (await getEntry("landing", lang))?.data;
if (!landing) throw new Error(`src/content/${lang}/landing.yaml is missing`);
// Every path this build serves. A link, the switch or an hreflang alternate names only one of these,
// so a draft or a language not yet live is never linked.
const served = new Set<string>([
  ...servedPathPages(pages, strictBuild, () => {}).flatMap((p) => p.data.path ?? []),
  ...servedTwinPaths(strictBuild),
]);
const twin = page.translation && served.has(page.translation) ? page.translation : undefined;
const { translation: _all, ...rest } = page;
const shown = twin ? { ...rest, translation: twin } : rest;
const tags = [...headTags(shown, path), ...xDefaultTag(shown, path)];
const links = landing.links.filter((l) => served.has(l.href));
const home = twinPath("index", lang);
const homeHref = home === "/" ? "/" : `${home}/`;
// The switch lists the page's own language and its twin's, each in its own code; it shows only when the
// build serves the twin.
const twinHref = twin === "/" ? "/" : `${twin}/`;
const switchOptions = [
  { value: lang, label: lang.toUpperCase(), href: path === "/" ? "/" : `${path}/`, lang },
  { value: other, label: other.toUpperCase(), href: twinHref, lang: other },
].sort((a, b) => (a.value === "pl" ? -1 : b.value === "pl" ? 1 : 0));
const footer = footerPaths(lang);
const footerLinks = [
  { href: footer.privacy, label: m.site_footer_privacy({}, locale) },
  { href: footer.deletion, label: m.site_footer_deletion({}, locale) },
].filter((l) => served.has(l.href));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>
    {
      tags.map((t) =>
        t.kind === "meta" ? (
          <meta name={t.name} content={t.content} />
        ) : t.kind === "property" ? (
          <meta property={t.property} content={t.content} />
        ) : (
          <link rel={t.rel} href={t.href} type={t.type} sizes={t.sizes} hreflang={t.hreflang} />
        ),
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd(lang))} />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      [id] { scroll-margin-top: 7rem; } /* an anchor lands below the sticky header */
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        margin: 0; background: var(--jw-ground); color: var(--jw-ink);
        font-family: var(--jw-font); font-size: 1.0625rem; line-height: 1.55;
      }
      a { color: var(--jw-brand-go); }
      a:focus-visible, button:focus-visible { outline: 3px solid var(--jw-focus); outline-offset: 3px; border-radius: 6px; }
      .wrap { max-width: 72rem; margin: 0 auto; padding: 0 1rem; }
      h1, h2, h3 { font-weight: 700; line-height: 1.2; margin: 0; }
      h2 { font-size: clamp(1.5rem, 3.5vw, 2rem); }
      h3 { font-size: 1.2rem; }
      p { margin: 0; }

      /* The one action a visitor can press, in the app's action look: ink-blue fill and a pressed edge. */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; min-height: 48px;
        padding: 0.7rem 1.4rem; border-radius: var(--jw-radius-control); font-weight: 700;
        text-decoration: none; color: var(--jw-on-act); background: var(--jw-act);
        box-shadow: 0 4px 0 var(--jw-act-edge); transition: transform 80ms, box-shadow 80ms;
      }
      .btn:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--jw-act-edge); }
      .btn.quiet { background: var(--jw-act-quiet); color: var(--jw-ink); box-shadow: 0 4px 0 var(--jw-line); }

      /* The header stays in reach on a long page: sticky, on the page's own white, its line below
         (design handoff "landing 3", SiteHeader). On a laptop: the wordmark, the page pills, then the
         language switch and the sign-in on the right, all on one centre line. On a phone: one 68 px row
         with the wordmark, the sign-in and a 48 px burger that opens the pages and the language. */
      .site-header {
        position: sticky; top: 0; z-index: 10; --logo-h: 3rem;
        background: var(--jw-ground); border-bottom: 2px solid var(--jw-line);
      }
      .site-header .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.5rem; min-height: 68px; padding-top: 0.5rem; }
      /* Hover 5a: only the crown tips, about the bottom-left corner of its box (packages/ui src/brand/
         README.md); a tap plays it once. The wordmark's box is 180 units tall, the crown's room included. */
      .logo { display: inline-flex; line-height: 0; flex: 1 0 auto; }
      .logo svg { height: var(--logo-h); width: auto; overflow: visible; }
      .logo .crown { transform-origin: -12.5px 2.15px; transition: transform 320ms cubic-bezier(.34, 1.8, .5, 1); }
      .logo:hover .crown, .logo:focus-visible .crown, .logo.tip .crown { transform: translateY(-12.5px) rotate(-18deg); }
      @media (prefers-reduced-motion: reduce) {
        .logo .crown, .logo:hover .crown, .logo:focus-visible .crown, .logo.tip .crown { transition: none; transform: none; }
      }
      /* The sign-in: an outlined 44 px pill, the pages' size, so it reads as a door, not the page's action. */
      .signin {
        order: 1; display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem;
        border: 2px solid var(--jw-ink); border-radius: 22px; color: var(--jw-ink); text-decoration: none;
        font-weight: 700; white-space: nowrap;
      }
      .signin:hover { background: var(--jw-act-quiet); }
      .burger {
        order: 2; width: 48px; height: 48px; display: inline-flex; flex-direction: column; align-items: center;
        justify-content: center; gap: 5px; padding: 0; cursor: pointer;
        border: 2px solid var(--jw-line); border-radius: var(--jw-radius-control); background: var(--jw-card);
      }
      .burger span { width: 20px; height: 2px; border-radius: 1px; background: var(--jw-ink); }
      .burger[aria-expanded="true"] { border-color: var(--jw-ink); background: var(--jw-pick); }
      /* Without the script the menu simply stays open under the row, so every page is still one tap away. */
      .menu { order: 3; width: 100%; display: flex; flex-direction: column; padding: 0.75rem 0 1.25rem; border-top: 2px solid var(--jw-line); margin-top: 0.5rem; }
      .js .menu:not(.open) { display: none; }
      html:not(.js) .burger { display: none; }
      .site-nav { display: flex; flex-direction: column; gap: 0.25rem; }
      .site-nav a {
        display: flex; align-items: center; min-height: 52px; padding: 0 1rem; font-size: 1.2rem; font-weight: 700;
        border: 2px solid transparent; border-radius: var(--jw-radius-control); color: var(--jw-ink); text-decoration: none;
      }
      .site-nav a:hover { background: var(--jw-act-quiet); }
      .site-nav a[aria-current] { background: var(--jw-pick); border-color: var(--jw-ink); color: var(--jw-pick-ink); }
      .lang-row {
        display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
        margin-top: 0.5rem; padding-top: 0.9rem; border-top: 2px solid var(--jw-line);
      }
      .lang-row > span { font-weight: 700; color: var(--jw-ink-soft); }
      @media (min-width: 60rem) {
        .site-header { --logo-h: 3.25rem; }
        .site-header .bar { flex-wrap: nowrap; gap: 1.5rem; min-height: 76px; padding-top: 0.25rem; }
        .logo { flex: none; }
        .burger { display: none; }
        .menu, .js .menu:not(.open) { order: 0; width: auto; flex: 1; display: flex; flex-direction: row; align-items: center; gap: 1.5rem; padding: 0; margin: 0; border: 0; }
        .site-nav { flex-direction: row; gap: 0.25rem; flex: 1; }
        .site-nav a { min-height: 44px; padding: 0 1rem; font-size: 1.05rem; border-radius: 22px; white-space: nowrap; }
        .lang-row { margin: 0; padding: 0; border: 0; }
        .lang-row > span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
      }

      /* The footer: the wordmark and its line, the pages, where the questions come from, and whose the
         data is (design handoff "landing 3", SiteFooter). The privacy pages sit under the data line. */
      .site-footer { border-top: 2px solid var(--jw-line); margin-top: 4rem; padding: 2rem 0 2.5rem; font-size: 1rem; line-height: 1.5; }
      .site-footer .wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr)); gap: 1.5rem 2rem; }
      .site-footer .col { display: flex; flex-direction: column; gap: 0.25rem; color: var(--jw-ink-soft); }
      .site-footer .col > strong { color: var(--jw-ink); }
      .site-footer a { color: var(--jw-ink); text-decoration: none; }
      .site-footer a:hover { text-decoration: underline; }
      .site-footer .mark { line-height: 0; margin-bottom: 0.25rem; }
      .site-footer .mark svg { height: 2.5rem; width: auto; overflow: visible; }
      .site-footer .data { text-wrap: pretty; }
      .site-footer .data a { color: var(--jw-ink-soft); text-decoration: underline; }

      /* Squared paper (kratka), the exercise book a child writes maths in: behind questions only. */
      .paper {
        --cell: 1.5rem;
        border: 2px solid var(--jw-line); border-radius: var(--jw-radius-card);
        background:
          linear-gradient(to right, var(--jw-line) 1px, transparent 1px) 0 0 / var(--cell) var(--cell),
          linear-gradient(to bottom, var(--jw-line) 1px, transparent 1px) 0 0 / var(--cell) var(--cell),
          var(--jw-card);
      }
      .prose main { max-width: 40rem; margin: 0 auto; padding: 2.5rem 1rem 0; }
      .prose h1 { font-size: clamp(1.8rem, 6vw, 2.5rem); }
      .prose h2 { font-size: 1.3rem; margin: 2rem 0 0.5rem; }
      .prose p { margin: 0.75rem 0 0; }
      .prose ol { padding-left: 1.25rem; }
      .prose li { margin-top: 0.4rem; }
      /* A photo still to come: a dashed frame with its label, until the picture is chosen. */
      .prose .frame {
        display: grid; place-items: center; aspect-ratio: 16 / 9; max-height: 16rem; width: 100%; margin: 1.5rem 0;
        border: 2px dashed var(--jw-line-strong); border-radius: var(--jw-radius-card);
        background: var(--jw-act-quiet); color: var(--jw-ink-soft); text-align: center; padding: 1rem;
      }
      .prose .draft {
        margin: 1rem 0 1.5rem; padding: 0.75rem 1rem; border-radius: 0.5rem;
        background: var(--jw-help); color: var(--jw-help-ink); font-size: 0.95rem;
      }
    </style>
  </head>
  <body class={prose ? "prose" : undefined}>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href={homeHref} aria-label={m.site_nav_home({}, locale)} set:html={wordmark} />
        <button class="burger" type="button" aria-expanded="false" aria-controls="site-menu" aria-label={m.site_menu({}, locale)}>
          <span></span><span></span><span></span>
        </button>
        <div class="menu" id="site-menu">
          <nav class="site-nav" aria-label={m.site_nav_label({}, locale)}>
            {links.map((n) => (
              <a href={`${n.href}/`} aria-current={path === n.href ? "page" : undefined}>
                {n.label}
              </a>
            ))}
          </nav>
          {
            twin && (
              <div class="lang-row">
                <span aria-hidden="true">{m.site_language_label({}, locale)}</span>
                <Segmented label={m.site_switch_label({}, locale)} value={lang} options={switchOptions} />
              </div>
            )
          }
        </div>
        <a class="signin" href={`${twinPath("signIn", lang)}/`}>{m.site_nav_sign_in({}, locale)}</a>
      </div>
    </header>
    {twin && <LanguageNote lang={lang} twin={other} href={twin === "/" ? "/" : `${twin}/`} />}
    <main>
      {prose && <h1>{page.heading}</h1>}
      {page.draftNote && <p class="draft" role="note">{page.draftNote}</p>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="col">
          <a class="mark" href={homeHref} aria-label={m.site_nav_home({}, locale)} set:html={wordmark} />
          <strong>{m.site_footer_line({}, locale)}</strong>
        </div>
        <div class="col">
          {links.map((n) => <a href={`${n.href}/`}>{n.label}</a>)}
        </div>
        <div class="col">
          <strong>{m.site_footer_sources({}, locale)}</strong>
          <span>Alfik Matematyczny</span>
          <span>Khan Academy</span>
        </div>
        <div class="col data">
          <strong>{m.site_footer_data_heading({}, locale)}</strong>
          <span>{m.site_footer_data({}, locale)}</span>
          {footerLinks.map((l) => <a href={`${l.href}/`}>{l.label}</a>)}
        </div>
      </div>
    </footer>
    <script is:inline>
      // On a touch screen there is no hover: a tap lifts the crown, holds it 200 ms, and lets it fall back.
      document.querySelector(".logo")?.addEventListener("pointerdown", (e) => {
        if (e.pointerType !== "touch") return;
        const logo = e.currentTarget;
        logo.classList.add("tip");
        setTimeout(() => logo.classList.remove("tip"), 520);
      });
      // The phone menu: the burger opens and closes it; Escape or a link closes it and gives focus back.
      const burger = document.querySelector(".burger");
      const menu = document.getElementById("site-menu");
      const setOpen = (open) => {
        burger?.setAttribute("aria-expanded", String(open));
        menu?.classList.toggle("open", open);
      };
      burger?.addEventListener("click", () => setOpen(burger.getAttribute("aria-expanded") !== "true"));
      menu?.addEventListener("click", (e) => { if (e.target.closest("a")) setOpen(false); });
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape" || burger?.getAttribute("aria-expanded") !== "true") return;
        setOpen(false);
        burger.focus();
      });
    </script>
  </body>
</html>
