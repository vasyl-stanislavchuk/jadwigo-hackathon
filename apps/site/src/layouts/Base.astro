---
// Every page's frame: Polish, the head from lib/seo.ts, Zeszyt's tokens and Andika, a header with the
// crown wordmark (decision jadwigo-marketing/decisions/2026-10-30-jadwigo-wears-lockup-4a-an-andika-
// wordmark-with-a-crown-tipped-o) and a footer. With `prose`, the words read top to bottom in a
// column under the page's heading, as the privacy pages do (dl-w0b4.64). Without it, the page brings
// its own sections and its own h1 (the landing page, dl-5ssh.4.1). The header links every page in
// landing.yaml's `links`, each its own page (owner, 2026-10-31). The frame's own words (the logo's
// and the nav's labels, the sign-in, the footer, the other language's name) are the site_* Paraglide
// messages in the page's language (dl-w0b4.82). The header's switch links the page's twin in the
// other language, when the build serves it (dl-w0b4.81).
import "@fontsource/andika/400.css";
import "@fontsource/andika/700.css";
import "@jadwigo/ui/foundation.css";
import { getCollection, getEntry } from "astro:content";
import { m } from "@jadwigo/copy/messages";
import wordmark from "@jadwigo/ui/brand/wordmark.svg?raw";
import { strictBuild } from "../lib/build.ts";
import {
  footerPaths,
  languageOf,
  otherLanguage,
  servedLanguages,
  servedTwinPaths,
  twinPath,
} from "../lib/i18n.ts";
import { assertReviewed, headTags, jsonLd, type Page, servedPathPages } from "../lib/seo.ts";

interface Props {
  page: Page;
  path: string;
  prose?: boolean;
}

const { page, path, prose = false } = Astro.props;
const lang = languageOf(page);
const other = otherLanguage(lang);
const locale = { locale: lang } as const;
const languages = servedLanguages(strictBuild);
// Only the pages of the languages this build serves count: an English draft holds back no Polish build.
const pages = (await getCollection("pages")).filter((p) => languages.includes(languageOf(p.data)));
assertReviewed(pages, strictBuild);
const landing = (await getEntry("landing", lang))?.data;
if (!landing) throw new Error(`src/content/${lang}/landing.yaml is missing`);
// Every path this build serves. A link, the switch or an hreflang alternate names only one of these,
// so a draft or a language not yet live is never linked.
const served = new Set<string>([
  ...servedPathPages(pages, strictBuild, () => {}).flatMap((p) => p.data.path ?? []),
  ...servedTwinPaths(strictBuild),
]);
const twin = page.translation && served.has(page.translation) ? page.translation : undefined;
const { translation: _all, ...rest } = page;
const tags = headTags(twin ? { ...rest, translation: twin } : rest, path);
const links = landing.links.filter((l) => served.has(l.href));
const home = twinPath("index", lang);
const footer = footerPaths(lang);
const footerLinks = [
  { href: footer.privacy, label: m.site_footer_privacy({}, locale) },
  { href: footer.deletion, label: m.site_footer_deletion({}, locale) },
].filter((l) => served.has(l.href));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>
    {
      tags.map((t) =>
        t.kind === "meta" ? (
          <meta name={t.name} content={t.content} />
        ) : t.kind === "property" ? (
          <meta property={t.property} content={t.content} />
        ) : (
          <link rel={t.rel} href={t.href} type={t.type} sizes={t.sizes} hreflang={t.hreflang} />
        ),
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd())} />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      [id] { scroll-margin-top: 7rem; } /* an anchor lands below the sticky header */
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        margin: 0; background: var(--jw-ground); color: var(--jw-ink);
        font-family: var(--jw-font); font-size: 1.0625rem; line-height: 1.55;
      }
      a { color: var(--jw-brand-go); }
      a:focus-visible, button:focus-visible { outline: 3px solid var(--jw-focus); outline-offset: 3px; border-radius: 6px; }
      .wrap { max-width: 72rem; margin: 0 auto; padding: 0 1rem; }
      h1, h2, h3 { font-weight: 700; line-height: 1.2; margin: 0; }
      h2 { font-size: clamp(1.5rem, 3.5vw, 2rem); }
      h3 { font-size: 1.2rem; }
      p { margin: 0; }

      /* The one action a visitor can press, in the app's action look: ink-blue fill and a pressed edge. */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; min-height: 48px;
        padding: 0.7rem 1.4rem; border-radius: var(--jw-radius-control); font-weight: 700;
        text-decoration: none; color: var(--jw-on-act); background: var(--jw-act);
        box-shadow: 0 4px 0 var(--jw-act-edge); transition: transform 80ms, box-shadow 80ms;
      }
      .btn:active { transform: translateY(3px); box-shadow: 0 1px 0 var(--jw-act-edge); }
      .btn.quiet { background: var(--jw-act-quiet); color: var(--jw-ink); box-shadow: 0 4px 0 var(--jw-line); }

      /* The header stays in reach on a long page: sticky, on the page's own white, its hairline below.
         The crown gets room above the wordmark so it never touches the top edge (dl-5ssh.4.9). */
      .site-header {
        position: sticky; top: 0; z-index: 10;
        background: var(--jw-ground); border-bottom: 1px solid var(--jw-line);
      }
      /* The wordmark's box is 180 units: the crown's room above, the "g" reaching its foot. The bottom
         padding is the top's plus the crown's spare room, so the space under the logo matches the
         space over the crown. */
      .site-header { --logo-h: 3rem; }
      .site-header .wrap { display: flex; align-items: center; gap: 0.5rem 1rem; padding-top: 0.75rem; padding-bottom: 1rem; }
      /* Hover 5a: only the crown tips, about the bottom-left corner of its box (packages/ui src/brand/
         README.md); a tap plays it once. The wordmark's box is 180 units tall, the crown's room included. */
      .logo { display: inline-flex; line-height: 0; }
      .logo svg { height: var(--logo-h); width: auto; overflow: visible; }
      @media (min-width: 52rem) { .site-header { --logo-h: 3.25rem; } }
      .logo .crown { transform-origin: -12.5px 2.15px; transition: transform 320ms cubic-bezier(.34, 1.8, .5, 1); }
      .logo:hover .crown, .logo:focus-visible .crown, .logo.tip .crown { transform: translateY(-12.5px) rotate(-18deg); }
      @media (prefers-reduced-motion: reduce) {
        .logo .crown, .logo:hover .crown, .logo:focus-visible .crown, .logo.tip .crown { transition: none; transform: none; }
      }
      .site-header .wrap { flex-wrap: wrap; }
      /* Each page link is a 44 px pill: hover wears the quiet fill, the page you are on wears the pick,
         as a picked answer does in the app. On a phone the pills sit in a row under the logo and
         scroll sideways if they must; the row starts flush with the logo, its first pill's text aligned. */
      .site-nav { display: flex; order: 3; width: calc(100% + 0.6rem); margin-left: -0.6rem; gap: 0.25rem; overflow-x: auto; white-space: nowrap; }
      .site-nav a {
        display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.6rem; font-size: 0.95rem;
        border-radius: var(--jw-radius-control); color: var(--jw-ink); text-decoration: none; font-weight: 700;
      }
      .site-nav a:hover { background: var(--jw-act-quiet); }
      .site-nav a[aria-current] { background: var(--jw-pick); color: var(--jw-pick-ink); }
      /* The sign-in is the nav's size, not a hero button's: the same text, a 40 px body. */
      /* The language switch: a quiet text link beside the sign-in, the other language's name in itself. */
      .site-header .switch {
        display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.5rem; margin-left: auto;
        color: var(--jw-ink-soft); font-size: 0.95rem; text-decoration: none; font-weight: 700;
      }
      .site-header .switch:hover { color: var(--jw-ink); text-decoration: underline; }
      .site-header .switch + .btn { margin-left: 0.25rem; }
      .site-header .btn { margin-left: auto; padding: 0 0.95rem; min-height: 40px; font-size: 1rem; box-shadow: 0 3px 0 var(--jw-line); }
      @media (min-width: 52rem) {
        .site-header .wrap { flex-wrap: nowrap; }
        .site-nav { order: 0; width: auto; margin-left: auto; overflow: visible; gap: 0.5rem; }
        .site-nav a { padding: 0 0.85rem; font-size: 1rem; }
        /* The one button stands a little apart from the pages, so it reads as an action, not a page. */
        .site-nav + .btn, .site-nav + .switch { margin-left: 1rem; }
        /* The links and the button stand on the wordmark's baseline, not its box's middle: the baseline
           (y 91 of -65..115) is 0.367 of the logo's height below the middle, less a 1rem text's baseline drop. A
           translate, so the header's height does not move. */
        .site-nav, .site-header .switch, .site-header .btn { translate: 0 calc(var(--logo-h) * 0.367 - 0.42rem); }
      }

      .site-footer { border-top: 1px solid var(--jw-line); margin-top: 4rem; padding: 2rem 0 3rem; color: var(--jw-ink-soft); }
      .site-footer .wrap { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; align-items: center; }
      .site-footer a { color: var(--jw-ink-soft); }

      .prose main { max-width: 40rem; margin: 0 auto; padding: 2.5rem 1rem 0; }
      .prose h1 { font-size: clamp(1.8rem, 6vw, 2.5rem); }
      .prose h2 { font-size: 1.3rem; margin: 2rem 0 0.5rem; }
      .prose p { margin: 0.75rem 0 0; }
      .prose ol { padding-left: 1.25rem; }
      .prose li { margin-top: 0.4rem; }
      /* A photo still to come: a dashed frame with its label, until the picture is chosen. */
      .prose .frame {
        display: grid; place-items: center; aspect-ratio: 16 / 9; max-height: 16rem; width: 100%; margin: 1.5rem 0;
        border: 2px dashed var(--jw-line-strong); border-radius: var(--jw-radius-card);
        background: var(--jw-act-quiet); color: var(--jw-ink-soft); text-align: center; padding: 1rem;
      }
      .prose .draft {
        margin: 1rem 0 1.5rem; padding: 0.75rem 1rem; border-radius: 0.5rem;
        background: var(--jw-help); color: var(--jw-help-ink); font-size: 0.95rem;
      }
    </style>
  </head>
  <body class={prose ? "prose" : undefined}>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={home === "/" ? "/" : `${home}/`} aria-label={m.site_nav_home({}, locale)} set:html={wordmark} />
        {
          <nav class="site-nav" aria-label={m.site_nav_label({}, locale)}>
            {links.map((n) => (
              <a href={`${n.href}/`} aria-current={path === n.href ? "page" : undefined}>
                {n.label}
              </a>
            ))}
          </nav>
        }
        {
          twin && (
            <a class="switch" href={twin === "/" ? "/" : `${twin}/`} hreflang={other} lang={other} aria-label={m.site_switch_label({}, locale)}>
              {m.site_language_name({}, { locale: other })}
            </a>
          )
        }
        <a class="btn quiet" href={`${twinPath("signIn", lang)}/`}>{m.site_nav_sign_in({}, locale)}</a>
      </div>
    </header>
    <main>
      {prose && <h1>{page.heading}</h1>}
      {page.draftNote && <p class="draft" role="note">{page.draftNote}</p>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© Jadwigo</span>
        {footerLinks.map((l) => <a href={`${l.href}/`}>{l.label}</a>)}
        <span>{m.site_footer_made({}, locale)}</span>
      </div>
    </footer>
    <script is:inline>
      // On a touch screen there is no hover: a tap lifts the crown, holds it 200 ms, and lets it fall back.
      document.querySelector(".logo")?.addEventListener("pointerdown", (e) => {
        if (e.pointerType !== "touch") return;
        const logo = e.currentTarget;
        logo.classList.add("tip");
        setTimeout(() => logo.classList.remove("tip"), 520);
      });
    </script>
  </body>
</html>
