# The keys jw reads, one line each. Fill them in ~/.config/jadwigo-bank/bank.env (mode 600, or jw
# refuses the file), not here: this file is committed and holds no value. The environment beats
# the file, and the file beats the default. JW_BANK_ENV_FILE names a different file.
JW_API_URL=  # the API's base URL; searches go to <JW_API_URL>/api/v1/question-searches
JW_BANK_READ_TOKEN=  # the bearer read token for JW_API_URL, from SSM /jadwigo/prod/bank-read-token
JW_BANK_URL=  # the bank's own search URL, a fallback until the API route is deployed
JW_BANK_TOKEN=  # the bearer token for JW_BANK_URL, from Secrets Manager jadwigo-bank/api-token
JW_BANK_TIMEOUT_SECS=  # seconds one search may take before it comes back degraded; default 10
JADWIGO_BANK_DIR=  # a checkout of the bank repo, whose sets/ jw question show reads
JADWIGO_KHAN_DIR=  # the synced Khan copy; default ~/.cache/jadwigo-bank/khan
JW_KHAN_CONVERTED=  # the converted items file; default <JADWIGO_KHAN_DIR>/converted/pl.json
