# apps/web's build settings. Vite reads .env and .env.local in this folder; copy this file to
# .env.local and change what you need. Only VITE_* keys reach the page, so nothing secret goes here.

# Where Khan pictures are served: a CloudFront path over the content bucket's khan/media/, so
# <VITE_MEDIA_URL>/<sha>.<ext> is one picture (SSM /jadwigo/bank/media-url, dl-n9fr.52).
# Empty keeps a picture ref same-origin; the tests run with it empty.
VITE_MEDIA_URL=https://dx5i3bka3zn5f.cloudfront.net
