{#- The 6 paper actions' marks, drawn in SVG so no font decides how they look. The same
    mark always means the same action, on every card and in page 1's legend. -#}
{% macro action(kind) %}
{% set ink = geom.ACTION_COLOURS[kind] %}
<svg class="icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="{{ ink }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
{% if kind == "circle" %}
  {#- a pencil loop drawn round a number, its end running past its start -#}
  <path d="M15 4.2C9.5 2.6 3 5.6 2.8 11.6 2.6 17.4 8.4 20.6 13.6 19.8 19.4 18.9 22 14.2 21 9.8 20.2 6.6 17.6 4.6 13.4 4.4"/>
  <text x="12" y="16" font-size="10.5" font-weight="700" text-anchor="middle" fill="{{ ink }}" stroke="none">7</text>
{% elif kind == "tick" %}
  <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 12.5l3.5 3.5L17 8.5"/>
{% elif kind == "write" %}
  <path d="M15.5 3.5l5 5L9 20H4v-5z"/><path d="M13 6l5 5"/>
{% elif kind == "draw" %}
  <path d="M3 18c3-6 5-6 7-2s4 4 6-2 3-6 5-7"/><circle cx="6" cy="6" r="2.2" fill="{{ ink }}"/>
{% elif kind == "join" %}
  <circle cx="4" cy="6" r="2.2" fill="{{ ink }}"/><circle cx="20" cy="18" r="2.2" fill="{{ ink }}"/><path d="M6 7.5l12 9"/>
{% elif kind == "number" %}
  <text x="12" y="16.2" font-size="10" font-weight="700" text-anchor="middle" fill="{{ ink }}" stroke="none">123</text>
{% endif %}
</svg>
{%- endmacro %}

{% macro star() %}
<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.5l2.9 6.2 6.6.7-5 4.5 1.4 6.6L12 17.2l-5.9 3.3 1.4-6.6-5-4.5 6.6-.7z" fill="none" stroke="#000" stroke-width="1.6" stroke-linejoin="round"/></svg>
{%- endmacro %}
