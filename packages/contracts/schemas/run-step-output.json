{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "$ref": "#/$defs/RunStepOutcome"
    },
    "events": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "outcome",
    "events"
  ],
  "additionalProperties": false,
  "$defs": {
    "RunStepOutcome": {
      "type": "string",
      "enum": [
        "continue",
        "awaiting_input",
        "turn_complete",
        "cancelled",
        "failed"
      ]
    }
  }
}
