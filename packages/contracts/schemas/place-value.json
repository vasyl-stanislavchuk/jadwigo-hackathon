{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "at": {
          "type": "number"
        }
      },
      "required": [
        "at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        }
      },
      "required": [
        "points"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "rows": {
          "type": "number"
        },
        "cols": {
          "type": "number"
        },
        "split": {
          "$ref": "#/$defs/GridSplit"
        }
      },
      "required": [
        "rows",
        "cols"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "heights": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "heights"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "#/$defs/ClockValue"
    },
    {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Denom"
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "shaded": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "shaded"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "GridSplit": {
      "type": "object",
      "properties": {
        "axis": {
          "type": "string",
          "enum": [
            "rows",
            "cols"
          ]
        },
        "at": {
          "type": "number"
        }
      },
      "required": [
        "axis",
        "at"
      ],
      "additionalProperties": false
    },
    "ClockValue": {
      "type": "object",
      "properties": {
        "hour_at": {
          "type": "number"
        },
        "m": {
          "type": "number"
        }
      },
      "required": [
        "hour_at",
        "m"
      ],
      "additionalProperties": false
    },
    "Denom": {
      "type": "string",
      "enum": [
        "gr1",
        "gr2",
        "gr5",
        "gr10",
        "gr20",
        "gr50",
        "zl1",
        "zl2",
        "zl5",
        "zl10",
        "zl20",
        "zl50",
        "zl100",
        "zl200"
      ]
    }
  }
}
