{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lang": {
      "type": "string",
      "const": "bash"
    },
    "copy": {
      "type": "boolean"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string"
          },
          "out": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "cmd",
          "out"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "lang",
    "copy",
    "lines"
  ],
  "additionalProperties": false
}
