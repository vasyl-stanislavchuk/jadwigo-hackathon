{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "correct": {
      "type": "boolean"
    },
    "mistake_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "correct": {
            "type": "boolean"
          },
          "mistake_class": {
            "type": [
              "string",
              "null"
            ]
          }
