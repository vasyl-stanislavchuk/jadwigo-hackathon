{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HintCard"
      }
    },
    "look": {
      "$ref": "#/$defs/HelpCard"
    },
    "boost": {
      "$ref": "#/$defs/HelpCard"
    },
    "boost_by_mistake": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/HelpCard"
      }
    },
    "give": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "worked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "almost": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "HintCard": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "pictures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Picture"
          }
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "Picture": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "decorative": {
          "type": "boolean",
          "const": true
        },
        "labels": {
          "$ref": "#/$defs/PictureLabels"
        }
      },
      "required": [
        "src",
        "alt",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "PictureLabels": {
      "type": "object",
      "properties": {
        "range": {
          "type": "array",
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PictureLabel"
          }
        }
      },
      "required": [
        "range",
        "items"
      ],
      "additionalProperties": false
    },
    "PictureLabel": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "alignment": {
          "type": "string"
        },
        "math": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "content",
        "coordinates",
        "alignment"
      ],
      "additionalProperties": false
    },
    "HelpCard": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "picture": {
          "$ref": "#/$defs/HelpPicture"
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "HelpPicture": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "image"
            },
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "dots"
            },
            "rows": {
              "type": "number"
            },
            "cols": {
              "type": "number"
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "rows",
            "cols",
            "alt"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
