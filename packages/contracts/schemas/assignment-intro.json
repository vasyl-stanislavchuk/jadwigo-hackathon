{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "question_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identity": {
      "type": "string",
      "enum": [
        "pick",
        "type",
        "none"
      ]
    },
    "open": {
      "type": "boolean"
    },
    "first_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "title",
    "language",
    "question_count",
    "identity",
    "open",
    "first_name"
  ],
  "additionalProperties": false,
  "$defs": {
    "Language": {
      "type": "string",
      "enum": [
        "pl",
        "en"
      ]
    }
  }
}
