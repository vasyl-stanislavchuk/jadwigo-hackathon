{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assignment_id": {
            "type": "string",
            "pattern": "^asg_[0-7][0-9a-hjkmnp-tv-z]{25}$"
          },
          "lesson_id": {
            "type": "string",
            "pattern": "^les_[0-7][0-9a-hjkmnp-tv-z]{25}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "enum": [
              "pl",
              "en",
              "uk"
            ]
          }
        },
        "required": [
          "assignment_id",
          "lesson_id",
          "title",
          "language"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "lessons"
  ],
  "additionalProperties": false
}
