{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FeaturedLesson"
      }
    }
  },
  "required": [
    "lessons"
  ],
  "additionalProperties": false,
  "$defs": {
    "FeaturedLesson": {
      "type": "object",
      "properties": {
        "assignment_id": {
          "$ref": "#/$defs/AssignmentId"
        },
        "lesson_id": {
          "$ref": "#/$defs/LessonId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "$ref": "#/$defs/Language"
        }
      },
      "required": [
        "assignment_id",
        "lesson_id",
        "title",
        "language"
      ],
      "additionalProperties": false
    },
    "AssignmentId": {
      "type": "string",
      "pattern": "^asg_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "LessonId": {
      "type": "string",
      "pattern": "^les_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "Language": {
      "type": "string",
      "enum": [
        "pl",
        "en",
        "uk"
      ]
    }
  }
}
