{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questions": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChooseQuestion"
      }
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": false,
  "$defs": {
    "ChooseQuestion": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChooseFormOption"
          }
        },
        "custom_allowed": {
          "type": "boolean"
        },
        "skippable": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "options",
        "custom_allowed",
        "skippable"
      ],
      "additionalProperties": false
    },
    "ChooseFormOption": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    }
  }
}
