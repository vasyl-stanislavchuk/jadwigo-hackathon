{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "#/$defs/EventId"
    },
    "media_type": {
      "$ref": "#/$defs/AttachmentMediaType"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  },
  "required": [
    "event_id",
    "media_type",
    "bytes"
  ],
  "additionalProperties": false,
  "$defs": {
    "EventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "AttachmentMediaType": {
      "type": "string",
      "enum": [
        "image/jpeg",
        "image/heic",
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ]
    }
  }
}
