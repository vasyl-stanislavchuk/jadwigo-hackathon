{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pod_id": {
      "$ref": "#/$defs/PodId"
    },
    "learner_id": {
      "$ref": "#/$defs/LearnerId"
    },
    "attempt_id": {
      "$ref": "#/$defs/AttemptId"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "try_no": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "$ref": "#/$defs/AnswerKind"
    },
    "skill_code": {
      "$ref": "#/$defs/SkillId"
    },
    "answered_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "help_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mistake_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "added": {
      "$ref": "#/$defs/Added"
    },
    "lesson_kind": {
      "$ref": "#/$defs/LessonKind"
    },
    "hold_verdicts": {
      "type": "boolean"
    }
  },
  "required": [
    "pod_id",
    "learner_id",
    "attempt_id",
    "seq",
    "try_no",
    "kind",
    "skill_code",
    "answered_at",
    "correct",
    "help_used",
    "latency_ms",
    "mistake_class",
    "added",
    "lesson_kind",
    "hold_verdicts"
  ],
  "additionalProperties": false,
  "$defs": {
    "PodId": {
      "type": "string",
      "pattern": "^pod_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "LearnerId": {
      "type": "string",
      "pattern": "^lrn_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "AnswerKind": {
      "type": "string",
      "enum": [
        "try",
        "skip"
      ]
    },
    "SkillId": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
    },
    "Added": {
      "type": "string",
      "enum": [
        "planned",
        "twin"
      ]
    },
    "LessonKind": {
      "type": "string",
      "enum": [
        "practice",
        "review",
        "check",
        "diagnostic"
      ]
    }
  }
}
