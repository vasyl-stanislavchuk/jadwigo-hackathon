{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attempt_id": {
      "type": "string",
      "pattern": "^att_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pod_id": {
      "type": "string",
      "pattern": "^pod_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "lesson_question_id": {
      "type": "string",
      "pattern": "^lq_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "added": {
      "type": "string",
      "enum": [
        "planned",
        "twin"
      ]
    },
    "placed": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "now",
            "review_round"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "added_for": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "help_released": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ended": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "correct",
            "skipped",
            "missed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "asked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "attempt_id",
    "seq",
    "pod_id",
    "lesson_question_id",
    "added",
    "placed",
    "added_for",
    "help_released",
    "ended",
    "asked_at"
  ],
  "additionalProperties": false
}
