{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "short": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "n",
    "short",
    "line",
    "url"
  ],
  "additionalProperties": false
}
