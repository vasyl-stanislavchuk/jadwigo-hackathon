{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposal_id": {
      "$ref": "#/$defs/ProposalId"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accepted",
        "dismissed"
      ]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "decided_by": {
      "$ref": "#/$defs/AccountId"
    }
  },
  "required": [
    "proposal_id",
    "decision",
    "decided_at",
    "decided_by"
  ],
  "additionalProperties": false,
  "$defs": {
    "ProposalId": {
      "type": "string",
      "pattern": "^p[1-9]$"
    },
    "AccountId": {
      "type": "string",
      "pattern": "^acc_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    }
  }
}
