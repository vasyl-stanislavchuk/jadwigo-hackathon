{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "pod_id": {
          "$ref": "#/$defs/PodId"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "status": {
          "$ref": "#/$defs/RunInboxStatus"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "kind": {
          "type": "string",
          "const": "message"
        },
        "payload": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "attachments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Attachment"
              }
            },
            "context": {
              "$ref": "#/$defs/MessageContext"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "pod_id",
        "event_id",
        "status",
        "created_at",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "pod_id": {
          "$ref": "#/$defs/PodId"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "status": {
          "$ref": "#/$defs/RunInboxStatus"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "kind": {
          "type": "string",
          "const": "steer"
        },
        "payload": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "enum": [
                "chat",
                "lesson_edit"
              ]
            },
            "question_ids": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "patch": {
              "$ref": "#/$defs/LessonPatch"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "pod_id",
        "event_id",
        "status",
        "created_at",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "pod_id": {
          "$ref": "#/$defs/PodId"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "status": {
          "$ref": "#/$defs/RunInboxStatus"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "kind": {
          "type": "string",
          "const": "approval"
        },
        "payload": {
          "type": "object",
          "properties": {
            "call_id": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "enum": [
                "approved",
                "rejected"
              ]
            },
            "feedback": {
              "type": "string"
            },
            "answers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "call_id",
            "decision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "pod_id",
        "event_id",
        "status",
        "created_at",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "pod_id": {
          "$ref": "#/$defs/PodId"
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "status": {
          "$ref": "#/$defs/RunInboxStatus"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "kind": {
          "type": "string",
          "const": "cancel"
        },
        "payload": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "pod_id",
        "event_id",
        "status",
        "created_at",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "PodId": {
      "type": "string",
      "pattern": "^pod_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "EventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "RunInboxStatus": {
      "type": "string",
      "enum": [
        "pending",
        "delivered"
      ]
    },
    "Attachment": {
      "type": "object",
      "properties": {
        "storage_path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "storage_path",
        "media_type"
      ],
      "additionalProperties": false
    },
    "MessageContext": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "learner_id": {
              "$ref": "#/$defs/LearnerId"
            }
          },
          "required": [
            "learner_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lesson_id": {
              "$ref": "#/$defs/LessonId"
            }
          },
          "required": [
            "lesson_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "LearnerId": {
      "type": "string",
      "pattern": "^lrn_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "LessonId": {
      "type": "string",
      "pattern": "^les_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "LessonPatch": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  }
}
