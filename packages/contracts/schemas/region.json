{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "polygon": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Point"
      }
    }
  },
  "required": [
    "id",
    "polygon"
  ],
  "additionalProperties": false,
  "$defs": {
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    }
  }
}
