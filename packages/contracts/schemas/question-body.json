{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/BankQuestionId"
    },
    "source": {
      "$ref": "#/$defs/QuestionSource"
    },
    "pl": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "key": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "help": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "say": {
          "type": "string"
        },
        "question_type": {
          "description": "The question type a lesson step names; its family is the variant's family",
          "$ref": "#/$defs/QuestionType"
        }
      },
      "required": [
        "family",
        "data",
        "key"
      ],
      "additionalProperties": false
    },
    "en": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "key": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "help": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "say": {
          "type": "string"
        },
        "question_type": {
          "description": "The question type a lesson step names; its family is the variant's family",
          "$ref": "#/$defs/QuestionType"
        }
      },
      "required": [
        "family",
        "data",
        "key"
      ],
      "additionalProperties": false
    },
    "problem_type": {
      "type": "string"
    },
    "question_type": {
      "description": "The question type of every variant that names none (an Alfik task's lettered_choice)",
      "$ref": "#/$defs/QuestionType"
    },
    "credit": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "licence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "licence"
      ],
      "additionalProperties": false
    },
    "pictures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}\\.[a-z0-9]+$",
            "description": "The picture's sha256 with its extension, under <source>/media/ in the bucket"
          },
          "decorative": {
            "type": "boolean"
          },
          "pl": {
            "type": "string",
            "description": "The picture's Polish alternative text"
          }
        },
        "required": [
          "ref",
          "decorative"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "credit"
  ],
  "additionalProperties": false,
  "description": "One bank question's private body from questions/<source>/<id>.json: a version per language with its family, data, key and help, the credit and the pictures by sha; a question with no playable variant yet carries only id, credit and problem_type; it reaches only a caller with the read token",
  "$defs": {
    "BankQuestionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "A bank question's id: a Khan item id such as x1a2b3c4 or an Alfik task id such as alfik_2024_k2_q07, letters, digits, _ and - only"
    },
    "QuestionSource": {
      "type": "string",
      "enum": [
        "khan",
        "alfik"
      ],
      "description": "Where a bank question comes from, and its prefix in the content bucket: khan, alfik"
    },
    "QuestionType": {
      "type": "string",
      "enum": [
        "true_false",
        "recognition",
        "lettered_choice",
        "multi_select",
        "mark_numbers",
        "fraction_compare",
        "production",
        "short_text",
        "expression",
        "measure",
        "fill_gaps",
        "fill_table",
        "label_picture",
        "column",
        "pyramid",
        "clock_read",
        "money_count",
        "order",
        "bucket",
        "match",
        "number_line_place",
        "hotspot",
        "spatial_build",
        "draw_graph",
        "clock_set",
        "money_pay",
        "fraction_shade",
        "area_model",
        "explain"
      ]
    }
  }
}
