{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "enter"
        },
        "input": {
          "type": "string",
          "enum": [
            "number",
            "text",
            "fraction"
          ]
        },
        "max_length": {
          "type": "number"
        },
        "range": {
          "$ref": "#/$defs/GapRange"
        },
        "at": {
          "$ref": "#/$defs/GapAt"
        },
        "letters": {
          "type": "string",
          "enum": [
            "pl",
            "none"
          ]
        },
        "decimal": {
          "type": "boolean"
        },
        "whole": {
          "type": "boolean"
        },
        "simplify": {
          "$ref": "#/$defs/Simplify"
        }
      },
      "required": [
        "id",
        "kind",
        "input"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "choose"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "at": {
          "$ref": "#/$defs/GapAt"
        }
      },
      "required": [
        "id",
        "kind",
        "options"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "GapRange": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "GapAt": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "Simplify": {
      "type": "string",
      "enum": [
        "required",
        "enforced"
      ]
    }
  }
}
