{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/LearnerId"
    },
    "first_name": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "first_name"
  ],
  "additionalProperties": false,
  "$defs": {
    "LearnerId": {
      "type": "string",
      "pattern": "^lrn_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    }
  }
}
