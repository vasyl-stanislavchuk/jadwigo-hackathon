{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Criterion"
      }
    },
    "criteria_version": {
      "type": "string"
    }
  },
  "required": [
    "criteria",
    "criteria_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "Criterion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "cite": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "cite"
      ],
      "additionalProperties": false
    }
  }
}
