{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "age_group": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        {
          "type": "null"
        }
      ]
    },
    "goals": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "first_name"
  ],
  "additionalProperties": false
}
