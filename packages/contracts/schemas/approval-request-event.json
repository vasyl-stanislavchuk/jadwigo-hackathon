{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "event_id": {
      "$ref": "#/$defs/EventId"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "type": {
      "type": "string",
      "const": "approval_request"
    },
    "payload": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "verb": {
          "$ref": "#/$defs/VerbName"
        },
        "summary": {
          "type": "string"
        },
        "choose": {
          "$ref": "#/$defs/ChooseForm"
        }
      },
      "required": [
        "call_id",
        "verb",
        "summary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "run_id",
    "seq",
    "event_id",
    "created_at",
    "type",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "EventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "VerbName": {
      "type": "string",
      "enum": [
        "lesson_draft",
        "lesson_show",
        "lesson_edit",
        "lesson_check",
        "question_search"
      ]
    },
    "ChooseForm": {
      "type": "object",
      "properties": {
        "questions": {
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChooseQuestion"
          }
        }
      },
      "required": [
        "questions"
      ],
      "additionalProperties": false
    },
    "ChooseQuestion": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ChooseFormOption"
          }
        },
        "custom_allowed": {
          "type": "boolean"
        },
        "skippable": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "options",
        "custom_allowed",
        "skippable"
      ],
      "additionalProperties": false
    },
    "ChooseFormOption": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    }
  }
}
