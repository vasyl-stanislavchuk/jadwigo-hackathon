{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "lesson_question_id": {
      "$ref": "#/$defs/LessonQuestionId"
    },
    "say": {
      "type": "string"
    },
    "added": {
      "$ref": "#/$defs/Added"
    },
    "ended": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageEnded"
        },
        {
          "type": "null"
        }
      ]
    },
    "help_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "seq",
    "lesson_question_id",
    "say",
    "added",
    "ended",
    "help_used"
  ],
  "additionalProperties": false,
  "$defs": {
    "LessonQuestionId": {
      "type": "string",
      "pattern": "^lq_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "Added": {
      "type": "string",
      "enum": [
        "planned",
        "twin"
      ]
    },
    "PageEnded": {
      "type": "string",
      "enum": [
        "correct",
        "skipped",
        "missed",
        "done"
      ]
    }
  }
}
