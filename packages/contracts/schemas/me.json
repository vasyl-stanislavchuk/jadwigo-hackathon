{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account": {
      "anyOf": [
        {
          "$ref": "#/$defs/Account"
        },
        {
          "type": "null"
        }
      ]
    },
    "member": {
      "anyOf": [
        {
          "$ref": "#/$defs/Member"
        },
        {
          "type": "null"
        }
      ]
    },
    "pod": {
      "anyOf": [
        {
          "$ref": "#/$defs/Pod"
        },
        {
          "type": "null"
        }
      ]
    },
    "learners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LearnerSnapshot"
      }
    }
  },
  "required": [
    "account",
    "member",
    "pod",
    "learners"
  ],
  "additionalProperties": false,
  "$defs": {
    "Account": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/AccountId"
        },
        "pod_id": {
          "$ref": "#/$defs/PodId"
        },
        "sub": {
          "$ref": "#/$defs/Uuid"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "id",
        "pod_id",
        "sub",
        "created_at"
      ],
      "additionalProperties": false
    },
    "AccountId": {
      "type": "string",
      "pattern": "^acc_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "PodId": {
      "type": "string",
      "pattern": "^pod_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Member": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/MemberId"
        },
        "pod_id": {
          "$ref": "#/$defs/PodId"
        },
        "account_id": {
          "$ref": "#/$defs/AccountId"
        },
        "role": {
          "$ref": "#/$defs/MemberRole"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "id",
        "pod_id",
        "account_id",
        "role",
        "created_at"
      ],
      "additionalProperties": false
    },
    "MemberId": {
      "type": "string",
      "pattern": "^mem_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "MemberRole": {
      "type": "string",
      "enum": [
        "parent",
        "self"
      ]
    },
    "Pod": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/PodId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "$ref": "#/$defs/Language"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "id",
        "name",
        "language",
        "created_at"
      ],
      "additionalProperties": false
    },
    "Language": {
      "type": "string",
      "enum": [
        "pl",
        "en",
        "uk"
      ]
    },
    "LearnerSnapshot": {
      "type": "object",
      "properties": {
        "learner": {
          "$ref": "#/$defs/Learner"
        },
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Goal"
          }
        }
      },
      "required": [
        "learner",
        "goals"
      ],
      "additionalProperties": false
    },
    "Learner": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/LearnerId"
        },
        "pod_id": {
          "$ref": "#/$defs/PodId"
        },
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "first_name": {
          "type": "string",
          "minLength": 1
        },
        "age_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "id",
        "pod_id",
        "handle",
        "first_name",
        "age_group",
        "created_at"
      ],
      "additionalProperties": false
    },
    "LearnerId": {
      "type": "string",
      "pattern": "^lrn_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "Goal": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/GoalId"
        },
        "pod_id": {
          "$ref": "#/$defs/PodId"
        },
        "learner_id": {
          "$ref": "#/$defs/LearnerId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "id",
        "pod_id",
        "learner_id",
        "name",
        "created_at"
      ],
      "additionalProperties": false
    },
    "GoalId": {
      "type": "string",
      "pattern": "^gol_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    }
  }
}
