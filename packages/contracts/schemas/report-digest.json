{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "shape": {
      "type": "string",
      "const": "digest/1"
    },
    "counts": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "questions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "days_played": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "attempts",
        "questions",
        "days_played"
      ],
      "additionalProperties": false
    },
    "skills_moved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_code": {
            "$ref": "#/$defs/SkillId"
          },
          "from": {
            "$ref": "#/$defs/MasteryLevel"
          },
          "to": {
            "$ref": "#/$defs/MasteryLevel"
          }
        },
        "required": [
          "skill_code",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "needs_attention": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkillId"
      }
    },
    "mistakes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_code": {
            "$ref": "#/$defs/SkillId"
          },
          "mistake_class": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "skill_code",
          "mistake_class",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "brief": {
      "$ref": "#/$defs/Brief"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "goal_id": {
            "$ref": "#/$defs/GoalId"
          },
          "status": {
            "$ref": "#/$defs/GoalProgress"
          }
        },
        "required": [
          "goal_id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "standing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "$ref": "#/$defs/StandingQuestion"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "on_track",
              "watch",
              "stuck",
              "nothing_recorded"
            ]
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Citation"
            }
          }
        },
        "required": [
          "question",
          "verdict",
          "citations"
        ],
        "additionalProperties": false
      }
    },
    "proposals": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/ProposalId"
          },
          "kind": {
            "type": "string",
            "const": "focus"
          },
          "list": {
            "$ref": "#/$defs/BriefList"
          },
          "skill_codes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/SkillId"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Citation"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "list",
          "skill_codes",
          "citations"
        ],
        "additionalProperties": false
      }
    },
    "asks": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "school",
              "goal_words",
              "unknown_skill"
            ]
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Citation"
            }
          }
        },
        "required": [
          "kind",
          "citations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "shape",
    "counts",
    "skills_moved",
    "needs_attention",
    "mistakes",
    "brief",
    "goals",
    "standing",
    "proposals",
    "asks"
  ],
  "additionalProperties": false,
  "$defs": {
    "SkillId": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
    },
    "MasteryLevel": {
      "type": "string",
      "enum": [
        "not_started",
        "attempted",
        "familiar",
        "proficient",
        "mastered"
      ]
    },
    "Brief": {
      "type": "object",
      "properties": {
        "made_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BriefEntry"
          }
        },
        "nothing_recorded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BriefList"
          }
        }
      },
      "required": [
        "made_at",
        "entries",
        "nothing_recorded"
      ],
      "additionalProperties": false
    },
    "BriefEntry": {
      "type": "object",
      "properties": {
        "list": {
          "$ref": "#/$defs/BriefList"
        },
        "skill_code": {
          "$ref": "#/$defs/SkillId"
        },
        "goal_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GoalId"
          }
        }
      },
      "required": [
        "list",
        "skill_code",
        "goal_ids"
      ],
      "additionalProperties": false
    },
    "BriefList": {
      "type": "string",
      "enum": [
        "reteach",
        "review",
        "new",
        "recheck",
        "school"
      ]
    },
    "GoalId": {
      "type": "string",
      "pattern": "^gol_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "GoalProgress": {
      "type": "string",
      "enum": [
        "not_started",
        "needs_attention",
        "on_its_way",
        "good"
      ]
    },
    "StandingQuestion": {
      "type": "string",
      "enum": [
        "skills_standing",
        "next_focus"
      ]
    },
    "Citation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "attempt"
            },
            "attempt_id": {
              "$ref": "#/$defs/AttemptId"
            }
          },
          "required": [
            "kind",
            "attempt_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skill"
            },
            "skill_code": {
              "$ref": "#/$defs/SkillId"
            }
          },
          "required": [
            "kind",
            "skill_code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "goal"
            },
            "goal_id": {
              "$ref": "#/$defs/GoalId"
            }
          },
          "required": [
            "kind",
            "goal_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "ProposalId": {
      "type": "string",
      "pattern": "^p[1-9]$"
    }
  }
}
