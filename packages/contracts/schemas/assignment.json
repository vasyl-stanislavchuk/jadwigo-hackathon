{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/AssignmentId"
    },
    "pod_id": {
      "$ref": "#/$defs/PodId"
    },
    "lesson_id": {
      "$ref": "#/$defs/LessonId"
    },
    "lesson_version_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/LessonVersionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "audience": {
      "type": "string",
      "enum": [
        "learners",
        "anyone"
      ]
    },
    "identity": {
      "type": "string",
      "enum": [
        "pick",
        "type",
        "none"
      ]
    },
    "after_not_sure": {
      "$ref": "#/$defs/AfterNotSure"
    },
    "hold_verdicts": {
      "type": "boolean"
    },
    "opens_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "closes_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "pod_id",
    "lesson_id",
    "lesson_version_id",
    "audience",
    "identity",
    "after_not_sure",
    "hold_verdicts",
    "opens_at",
    "closes_at",
    "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "AssignmentId": {
      "type": "string",
      "pattern": "^asg_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "PodId": {
      "type": "string",
      "pattern": "^pod_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "LessonId": {
      "type": "string",
      "pattern": "^les_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "LessonVersionId": {
      "type": "string",
      "pattern": "^lesv_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "AfterNotSure": {
      "type": "string",
      "enum": [
        "next",
        "twin_now",
        "review_round"
      ]
    }
  }
}
