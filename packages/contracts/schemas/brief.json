{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "computed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BriefEntry"
      }
    },
    "school": {
      "anyOf": [
        {
          "type": "string",
          "const": "nothing_recorded"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BriefEntry"
          }
        }
      ]
    }
  },
  "required": [
    "computed_at",
    "entries",
    "school"
  ],
  "additionalProperties": false,
  "$defs": {
    "BriefEntry": {
      "type": "object",
      "properties": {
        "skill_code": {
          "$ref": "#/$defs/SkillId"
        },
        "list": {
          "$ref": "#/$defs/BriefList"
        },
        "goal_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GoalId"
          }
        },
        "why": {
          "type": "string",
          "enum": [
            "needs_attention",
            "review_due",
            "prerequisites_met",
            "second_day_owed",
            "school_tag"
          ]
        }
      },
      "required": [
        "skill_code",
        "list",
        "goal_ids",
        "why"
      ],
      "additionalProperties": false
    },
    "SkillId": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
    },
    "BriefList": {
      "type": "string",
      "enum": [
        "reteach",
        "review",
        "new",
        "recheck",
        "school"
      ]
    },
    "GoalId": {
      "type": "string",
      "pattern": "^gol_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    }
  }
}
