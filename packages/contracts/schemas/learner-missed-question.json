{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attempt_id": {
      "$ref": "#/$defs/AttemptId"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "say": {
      "type": "string"
    },
    "mistake_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "skipped": {
      "type": "boolean"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "attempt_id",
    "seq",
    "say",
    "mistake_classes",
    "tries",
    "skipped",
    "answers"
  ],
  "additionalProperties": false,
  "$defs": {
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    }
  }
}
