{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attachment_id": {
      "$ref": "#/$defs/AttachmentId"
    },
    "storage_path": {
      "type": "string",
      "minLength": 1
    },
    "media_type": {
      "$ref": "#/$defs/AttachmentMediaType"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "width": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "height": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "attachment_id",
    "storage_path",
    "media_type",
    "bytes",
    "width",
    "height"
  ],
  "additionalProperties": false,
  "$defs": {
    "AttachmentId": {
      "type": "string",
      "pattern": "^atch_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "AttachmentMediaType": {
      "type": "string",
      "enum": [
        "image/jpeg",
        "image/heic",
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ]
    }
  }
}
