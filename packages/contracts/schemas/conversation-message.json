{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "#/$defs/EventId"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "message",
        "steer"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "chat",
        "lesson_edit"
      ]
    },
    "question_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "patch": {
      "$ref": "#/$defs/LessonPatch"
    }
  },
  "required": [
    "event_id",
    "text"
  ],
  "additionalProperties": false,
  "$defs": {
    "EventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "LessonPatch": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  }
}
