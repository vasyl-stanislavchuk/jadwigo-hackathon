{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "#/$defs/EventId"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "event_id",
    "text"
  ],
  "additionalProperties": false,
  "$defs": {
    "EventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
