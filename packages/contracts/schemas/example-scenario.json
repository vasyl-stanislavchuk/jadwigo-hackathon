{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "try": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "outcome": {
      "type": "string",
      "enum": [
        "correct",
        "incorrect"
      ]
    },
    "mistake_class": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "marks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PartMark"
      }
    }
  },
  "required": [
    "try",
    "value",
    "outcome",
    "mistake_class",
    "marks"
  ],
  "additionalProperties": false,
  "$defs": {
    "PartMark": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "correct": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "correct"
      ],
      "additionalProperties": false
    }
  }
}
