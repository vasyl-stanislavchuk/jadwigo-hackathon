{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pod_id": {
      "$ref": "#/$defs/PodId"
    },
    "attempt_id": {
      "$ref": "#/$defs/AttemptId"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "lesson_question_id": {
      "$ref": "#/$defs/LessonQuestionId"
    },
    "added": {
      "$ref": "#/$defs/Added"
    },
    "placed": {
      "anyOf": [
        {
          "$ref": "#/$defs/Placed"
        },
        {
          "type": "null"
        }
      ]
    },
    "added_for": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "say": {
      "type": "string"
    },
    "family": {
      "$ref": "#/$defs/Family"
    },
    "question_type": {
      "$ref": "#/$defs/QuestionType"
    },
    "tries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "first_try_correct": {
      "type": "boolean"
    },
    "correct": {
      "type": "boolean"
    },
    "mistake_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "help_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "skip_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkipReason"
        },
        {
          "type": "null"
        }
      ]
    },
    "time_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ended": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ended"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "pod_id",
    "attempt_id",
    "seq",
    "lesson_question_id",
    "added",
    "placed",
    "added_for",
    "say",
    "family",
    "question_type",
    "tries",
    "first_try_correct",
    "correct",
    "mistake_classes",
    "help_used",
    "skip_reason",
    "time_ms",
    "ended"
  ],
  "additionalProperties": false,
  "$defs": {
    "PodId": {
      "type": "string",
      "pattern": "^pod_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "LessonQuestionId": {
      "type": "string",
      "pattern": "^lq_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "Added": {
      "type": "string",
      "enum": [
        "planned",
        "twin"
      ]
    },
    "Placed": {
      "type": "string",
      "enum": [
        "now",
        "review_round"
      ]
    },
    "Family": {
      "type": "string",
      "enum": [
        "choose",
        "enter",
        "slots",
        "sequence",
        "group",
        "place",
        "explain"
      ]
    },
    "QuestionType": {
      "type": "string",
      "enum": [
        "true_false",
        "recognition",
        "lettered_choice",
        "multi_select",
        "mark_numbers",
        "fraction_compare",
        "production",
        "short_text",
        "expression",
        "measure",
        "fill_gaps",
        "fill_table",
        "label_picture",
        "column",
        "pyramid",
        "clock_read",
        "money_count",
        "order",
        "bucket",
        "match",
        "number_line_place",
        "hotspot",
        "spatial_build",
        "draw_graph",
        "clock_set",
        "money_pay",
        "fraction_shade",
        "area_model",
        "explain"
      ]
    },
    "SkipReason": {
      "type": "string",
      "enum": [
        "dont_know",
        "asked_to_skip",
        "help_twin"
      ]
    },
    "Ended": {
      "type": "string",
      "enum": [
        "correct",
        "skipped",
        "missed"
      ]
    }
  }
}
