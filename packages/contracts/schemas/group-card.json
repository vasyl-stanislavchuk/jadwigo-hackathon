{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "picture": {
      "$ref": "#/$defs/Picture"
    }
  },
  "required": [
    "id",
    "label"
  ],
  "additionalProperties": false,
  "$defs": {
    "Picture": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "decorative": {
          "type": "boolean",
          "const": true
        },
        "labels": {
          "$ref": "#/$defs/PictureLabels"
        }
      },
      "required": [
        "src",
        "alt",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "PictureLabels": {
      "type": "object",
      "properties": {
        "range": {
          "type": "array",
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PictureLabel"
          }
        }
      },
      "required": [
        "range",
        "items"
      ],
      "additionalProperties": false
    },
    "PictureLabel": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "alignment": {
          "type": "string"
        },
        "math": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "content",
        "coordinates",
        "alignment"
      ],
      "additionalProperties": false
    }
  }
}
