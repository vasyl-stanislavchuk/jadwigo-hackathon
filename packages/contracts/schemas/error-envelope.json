{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/ErrorType"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "$defs": {
    "ErrorType": {
      "type": "string",
      "enum": [
        "BadRequest",
        "ServerFieldSupplied",
        "NotSignedIn",
        "NotFound",
        "AccountMissing",
        "AttemptClaimed",
        "AttemptPreview",
        "AssignmentClosed",
        "AttemptFinished",
        "AttemptPaused",
        "QuestionNotOpen",
        "TryOutOfOrder",
        "AnswerConflict",
        "EventIdMismatch",
        "WriteOnce",
        "AnswerLimit",
        "Unauthorized",
        "BankUnavailable"
      ]
    }
  }
}
