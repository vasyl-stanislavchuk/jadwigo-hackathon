{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "pending"
        },
        "print_id": {
          "$ref": "#/$defs/PrintId"
        }
      },
      "required": [
        "status",
        "print_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "ready"
        },
        "print_id": {
          "$ref": "#/$defs/PrintId"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "status",
        "print_id",
        "url",
        "expires_at"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "failed"
        },
        "print_id": {
          "$ref": "#/$defs/PrintId"
        },
        "reason": {
          "$ref": "#/$defs/PrintFailure"
        }
      },
      "required": [
        "status",
        "print_id",
        "reason"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "PrintId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "PrintFailure": {
      "type": "string",
      "enum": [
        "invalid_sheet",
        "render_failed"
      ]
    }
  }
}
