{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "try_no": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "$ref": "#/$defs/AnswerKind"
    },
    "value": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "parts": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PartVerdict"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "mistake_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "help_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "skip_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkipReason"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "try_no",
    "kind",
    "value",
    "correct",
    "parts",
    "mistake_class",
    "latency_ms",
    "help_used",
    "skip_reason"
  ],
  "additionalProperties": false,
  "$defs": {
    "AnswerKind": {
      "type": "string",
      "enum": [
        "try",
        "skip"
      ]
    },
    "AnswerValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChooseValue"
        },
        {
          "$ref": "#/$defs/EnterValue"
        },
        {
          "$ref": "#/$defs/SlotsValue"
        },
        {
          "$ref": "#/$defs/SequenceValue"
        },
        {
          "$ref": "#/$defs/GroupValue"
        },
        {
          "$ref": "#/$defs/PlaceValue"
        },
        {
          "$ref": "#/$defs/ExplainValue"
        }
      ]
    },
    "ChooseValue": {
      "type": "object",
      "properties": {
        "chosen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "chosen"
      ],
      "additionalProperties": false
    },
    "EnterValue": {
      "type": "object",
      "properties": {
        "entered": {
          "type": "string"
        }
      },
      "required": [
        "entered"
      ],
      "additionalProperties": false
    },
    "SlotsValue": {
      "type": "object",
      "properties": {
        "gaps": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "gaps"
      ],
      "additionalProperties": false
    },
    "SequenceValue": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "GroupValue": {
      "type": "object",
      "properties": {
        "items": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "PlaceValue": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "number"
            }
          },
          "required": [
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "points": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Point"
              }
            }
          },
          "required": [
            "points"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rows": {
              "type": "number"
            },
            "cols": {
              "type": "number"
            },
            "split": {
              "$ref": "#/$defs/GridSplit"
            }
          },
          "required": [
            "rows",
            "cols"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "heights": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "required": [
            "heights"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/ClockValue"
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Denom"
              }
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "shaded": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "shaded"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "GridSplit": {
      "type": "object",
      "properties": {
        "axis": {
          "type": "string",
          "enum": [
            "rows",
            "cols"
          ]
        },
        "at": {
          "type": "number"
        }
      },
      "required": [
        "axis",
        "at"
      ],
      "additionalProperties": false
    },
    "ClockValue": {
      "type": "object",
      "properties": {
        "hour_at": {
          "type": "number"
        },
        "m": {
          "type": "number"
        }
      },
      "required": [
        "hour_at",
        "m"
      ],
      "additionalProperties": false
    },
    "Denom": {
      "type": "string",
      "enum": [
        "gr1",
        "gr2",
        "gr5",
        "gr10",
        "gr20",
        "gr50",
        "zl1",
        "zl2",
        "zl5",
        "zl10",
        "zl20",
        "zl50",
        "zl100",
        "zl200"
      ]
    },
    "ExplainValue": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "spoken": {
          "type": "boolean"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "PartVerdict": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "correct": {
          "type": "boolean"
        },
        "mistake_class": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "correct",
        "mistake_class"
      ],
      "additionalProperties": false
    },
    "SkipReason": {
      "type": "string",
      "enum": [
        "dont_know",
        "asked_to_skip",
        "help_twin"
      ]
    }
  }
}
