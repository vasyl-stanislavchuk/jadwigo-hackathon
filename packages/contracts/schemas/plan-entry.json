{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "#/$defs/PlanStatus"
    }
  },
  "required": [
    "text",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "PlanStatus": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "done",
        "failed"
      ]
    }
  }
}
