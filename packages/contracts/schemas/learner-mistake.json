{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mistake_class": {
      "type": "string",
      "minLength": 1
    },
    "times": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Citation"
      }
    }
  },
  "required": [
    "mistake_class",
    "times",
    "citations"
  ],
  "additionalProperties": false,
  "$defs": {
    "Citation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "attempt"
            },
            "attempt_id": {
              "$ref": "#/$defs/AttemptId"
            }
          },
          "required": [
            "kind",
            "attempt_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skill"
            },
            "skill_code": {
              "$ref": "#/$defs/SkillId"
            }
          },
          "required": [
            "kind",
            "skill_code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "goal"
            },
            "goal_id": {
              "$ref": "#/$defs/GoalId"
            }
          },
          "required": [
            "kind",
            "goal_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "SkillId": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
    },
    "GoalId": {
      "type": "string",
      "pattern": "^gol_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    }
  }
}
