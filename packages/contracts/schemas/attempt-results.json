{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attempt": {
      "$ref": "#/$defs/Attempt"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PageAttemptResult"
      }
    }
  },
  "required": [
    "attempt",
    "results"
  ],
  "additionalProperties": false,
  "$defs": {
    "Attempt": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/AttemptId"
        },
        "pod_id": {
          "$ref": "#/$defs/PodId"
        },
        "assignment_id": {
          "$ref": "#/$defs/AssignmentId"
        },
        "lesson_version_id": {
          "$ref": "#/$defs/LessonVersionId"
        },
        "learner_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/LearnerId"
            },
            {
              "type": "null"
            }
          ]
        },
        "player_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "real",
            "preview"
          ]
        },
        "status": {
          "$ref": "#/$defs/AttemptStatus"
        },
        "resume_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "pod_id",
        "assignment_id",
        "lesson_version_id",
        "learner_id",
        "player_name",
        "mode",
        "status",
        "resume_at",
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "PodId": {
      "type": "string",
      "pattern": "^pod_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "AssignmentId": {
      "type": "string",
      "pattern": "^asg_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "LessonVersionId": {
      "type": "string",
      "pattern": "^lesv_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "LearnerId": {
      "type": "string",
      "pattern": "^lrn_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "AttemptStatus": {
      "type": "string",
      "enum": [
        "in_progress",
        "paused",
        "finished"
      ]
    },
    "PageAttemptResult": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lesson_question_id": {
          "$ref": "#/$defs/LessonQuestionId"
        },
        "say": {
          "type": "string"
        },
        "added": {
          "$ref": "#/$defs/Added"
        },
        "ended": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageEnded"
            },
            {
              "type": "null"
            }
          ]
        },
        "help_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "seq",
        "lesson_question_id",
        "say",
        "added",
        "ended",
        "help_used"
      ],
      "additionalProperties": false
    },
    "LessonQuestionId": {
      "type": "string",
      "pattern": "^lq_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "Added": {
      "type": "string",
      "enum": [
        "planned",
        "twin"
      ]
    },
    "PageEnded": {
      "type": "string",
      "enum": [
        "correct",
        "skipped",
        "missed",
        "done"
      ]
    }
  }
}
