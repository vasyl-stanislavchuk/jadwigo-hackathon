  "$defs": {
    "TickLabelStyle": {
      "type": "string",
      "enum": [
        "decimal",
        "fraction",
        "mixed",
        "non-reduced"
      ]
    },
    "LineDivisions": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "Stem": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "image_alt": {
          "type": "string"
        },
        "text_replaces_say": {
          "type": "boolean"
        },
        "pictures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Picture"
          }
        },
        "terminal": {
          "$ref": "#/$defs/TerminalCard"
        },
        "figure": {
          "$ref": "#/$defs/Figure"
        },
        "reference": {
          "$ref": "#/$defs/StemReference"
        },
        "audio": {
          "type": "object",
          "properties": {
            "clip": {
              "type": "string"
            },
            "slow": {
              "type": "string"
            }
          },
          "required": [
            "clip"
          ],
          "additionalProperties": false
        },
        "audio_text": {
          "$ref": "#/$defs/AudioText"
        }
      },
      "additionalProperties": false
    },
    "Picture": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "decorative": {
          "type": "boolean",
          "const": true
        },
        "labels": {
          "$ref": "#/$defs/PictureLabels"
        }
      },
      "required": [
        "src",
        "alt",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "PictureLabels": {
      "type": "object",
      "properties": {
        "range": {
          "type": "array",
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PictureLabel"
          }
        }
      },
      "required": [
        "range",
        "items"
      ],
      "additionalProperties": false
    },
    "PictureLabel": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "alignment": {
          "type": "string"
        },
        "math": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "content",
        "coordinates",
        "alignment"
      ],
      "additionalProperties": false
    },
    "TerminalCard": {
      "type": "object",
      "properties": {
        "lang": {
          "type": "string",
          "const": "bash"
        },
        "copy": {
          "type": "boolean"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string"
              },
              "out": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "cmd",
              "out"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "lang",
        "copy",
        "lines"
      ],
      "additionalProperties": false
    },
    "Figure": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "expression"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number_line"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number"
            },
            "labelled": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "marker": {
              "type": "number"
            },
            "tick_label": {
              "$ref": "#/$defs/TickLabelStyle"
            }
          },
          "required": [
            "kind",
            "min",
            "max",
            "step",
            "labelled",
            "marker"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "dots"
            },
            "rows": {
              "type": "number"
            },
            "cols": {
              "type": "number"
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "rows",
            "cols",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "groups"
            },
            "groups": {
              "type": "number"
            },
            "each": {
              "type": "number"
            },
            "icon": {
              "$ref": "#/$defs/GroupIcon"
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "groups",
            "each",
            "icon",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ruler"
            },
            "picture": {
              "$ref": "#/$defs/Picture"
            },
            "unit": {
              "type": "string",
              "enum": [
                "cm",
                "mm"
              ]
            },
            "length": {
              "type": "number"
            },
            "pixels_per_unit": {
              "type": "number"
            },
            "ticks": {
              "type": "number"
            },
            "start": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "picture",
            "unit",
            "length",
            "pixels_per_unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "clock"
            },
            "h": {
              "type": "number"
            },
            "m": {
              "type": "number"
            },
            "numbers": {
              "type": "string",
              "enum": [
                "arabic",
                "none"
              ]
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "h",
            "m",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "coins"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Denom"
              }
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "items",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fraction_bars"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "n": {
                    "type": "number"
                  },
                  "d": {
                    "type": "number"
                  }
                },
                "required": [
                  "n",
                  "d"
                ],
                "additionalProperties": false
              }
            },
            "shape": {
              "type": "string",
              "enum": [
                "bar",
                "circle"
              ]
            },
            "alt": {
              "type": "string"
            },
            "labels": {
              "type": "string",
              "enum": [
                "shown",
                "none"
              ]
            }
          },
          "required": [
            "kind",
            "items",
            "shape",
            "alt"
          ],
          "additionalProperties": false
        }
      ]
    },
    "GroupIcon": {
      "type": "string",
      "enum": [
        "apple",
        "star",
        "heart",
        "fish",
        "flower",
        "cherry"
      ]
    },
    "Denom": {
      "type": "string",
      "enum": [
        "gr1",
        "gr2",
        "gr5",
        "gr10",
        "gr20",
        "gr50",
        "zl1",
        "zl2",
        "zl5",
        "zl10",
        "zl20",
        "zl50",
        "zl100",
        "zl200"
      ]
    },
    "StemReference": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "prompt",
        "text"
      ],
      "additionalProperties": false
    },
    "AudioText": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "slow": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "text",
        "language"
      ],
      "additionalProperties": false
    },
    "GraphKind": {
      "type": "string",
      "enum": [
        "bar",
        "picture",
        "line_plot",
        "dot_plot",
        "line",
        "histogram"
      ]
    },
    "GraphCategory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "picture": {
          "$ref": "#/$defs/GraphPicture"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "GraphPicture": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "icon": {
              "$ref": "#/$defs/GraphIcon"
            }
          },
          "required": [
            "icon"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        }
      ]
    },
    "GraphIcon": {
      "type": "string",
      "enum": [
        "apple",
        "banana",
        "cherry",
        "grape",
        "candy",
        "cookie",
        "ice_cream",
        "pizza",
        "egg",
        "sun",
        "cloud",
        "rain",
        "snow",
        "flower",
        "leaf",
        "dog",
        "cat",
        "fish",
        "bird",
        "star",
        "heart",
        "smile",
        "book",
        "pencil",
        "car",
        "bus",
        "square"
      ]
    },
    "ClockValue": {
      "type": "object",
      "properties": {
        "hour_at": {
          "type": "number"
        },
        "m": {
          "type": "number"
        }
      },
      "required": [
        "hour_at",
        "m"
      ],
      "additionalProperties": false
    }
  }
}
