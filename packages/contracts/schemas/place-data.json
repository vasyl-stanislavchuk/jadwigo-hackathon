{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string",
          "const": "number_line"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "labelled": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "target_label": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "tick_label": {
          "$ref": "#/$defs/TickLabelStyle"
        },
        "snap": {
          "type": "number"
        },
        "divisions": {
          "$ref": "#/$defs/LineDivisions"
        },
        "stem": {
          "$ref": "#/$defs/Stem"
        }
      },
      "required": [
        "surface",
        "min",
        "max",
        "step",
        "labelled"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string",
          "const": "image"
        },
        "image": {
          "type": "string"
        },
        "image_alt": {
          "type": "string"
        },
        "taps": {
          "type": "number"
        },
        "stem": {
          "$ref": "#/$defs/Stem"
        }
      },
      "required": [
        "surface",
        "image",
        "image_alt",
        "taps"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string",
          "const": "grid"
        },
        "size": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "split": {
          "type": "string",
          "const": "one"
        },
        "cells": {
          "type": "string",
          "enum": [
            "dots",
            "squares",
            "open"
          ]
        },
        "stem": {
          "$ref": "#/$defs/Stem"
        }
      },
      "required": [
        "surface",
        "size",
        "label"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string",
          "const": "bars"
        },
        "kind": {
          "$ref": "#/$defs/GraphKind"
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GraphCategory"
          }
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "tick": {
          "type": "number"
        },
        "unit_label": {
          "type": "string"
        },
        "category_label": {
          "type": "string"
        },
        "starting": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "stem": {
          "$ref": "#/$defs/Stem"
        },
        "bins": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "surface",
        "kind",
        "categories",
        "max",
        "step"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string",
          "const": "clock"
        },
        "target_label": {
          "type": "string"
        },
        "minute_step": {
          "anyOf": [
            {
              "type": "number",
              "const": 5
            },
            {
              "type": "number",
              "const": 15
            },
            {
              "type": "number",
              "const": 30
            }
          ]
        },
        "hands": {
          "type": "string",
          "enum": [
            "geared",
            "free"
          ]
        },
        "starting": {
          "$ref": "#/$defs/ClockValue"
        },
        "stem": {
          "$ref": "#/$defs/Stem"
        }
      },
      "required": [
        "surface",
        "target_label",
        "minute_step",
        "hands"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string",
          "const": "coins"
        },
        "bank": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Denom"
          }
        },
        "amount_label": {
          "type": "string"
        },
        "slots": {
          "type": "number"
        },
        "total": {
          "type": "string",
          "enum": [
            "hidden",
            "shown"
          ]
        },
        "stem": {
          "$ref": "#/$defs/Stem"
        }
      },
      "required": [
        "surface",
        "bank",
        "amount_label",
        "slots"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "surface": {
          "type": "string",
          "const": "fraction"
        },
        "shape": {
          "type": "string",
          "enum": [
            "bar",
            "circle",
            "rect"
          ]
        },
        "parts": {
          "type": "number"
        },
        "rows": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "contiguous": {
          "type": "boolean"
        },
        "stem": {
          "$ref": "#/$defs/Stem"
        }
      },
      "required": [
        "surface",
        "shape",
        "parts",
        "label"
      ],
      "additionalProperties": false
    }
