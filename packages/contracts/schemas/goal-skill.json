{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pod_id": {
      "$ref": "#/$defs/PodId"
    },
    "goal_id": {
      "$ref": "#/$defs/GoalId"
    },
    "skill_code": {
      "$ref": "#/$defs/SkillId"
    }
  },
  "required": [
    "pod_id",
    "goal_id",
    "skill_code"
  ],
  "additionalProperties": false,
  "$defs": {
    "PodId": {
      "type": "string",
      "pattern": "^pod_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "GoalId": {
      "type": "string",
      "pattern": "^gol_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "SkillId": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
    }
  }
}
