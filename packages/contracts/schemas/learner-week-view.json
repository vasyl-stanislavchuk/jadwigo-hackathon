{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "learner": {
      "$ref": "#/$defs/LearnerRef"
    },
    "weeks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LearnerWeekCounts"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LearnerWeekLesson"
      }
    }
  },
  "required": [
    "learner",
    "weeks",
    "lessons"
  ],
  "additionalProperties": false,
  "$defs": {
    "LearnerRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/LearnerId"
        },
        "first_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "first_name"
      ],
      "additionalProperties": false
    },
    "LearnerId": {
      "type": "string",
      "pattern": "^lrn_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "LearnerWeekCounts": {
      "type": "object",
      "properties": {
        "monday": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "lessons": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "moved_up": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attention": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "monday",
        "lessons",
        "moved_up",
        "attention"
      ],
      "additionalProperties": false
    },
    "LearnerWeekLesson": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "$ref": "#/$defs/Language"
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "finished": {
          "type": "boolean"
        },
        "questions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "attempt_id",
        "title",
        "language",
        "started_at",
        "finished",
        "questions"
      ],
      "additionalProperties": false
    },
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "Language": {
      "type": "string",
      "enum": [
        "pl",
        "en"
      ]
    }
  }
}
