{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "attempt"
        },
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        }
      },
      "required": [
        "kind",
        "attempt_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "skill"
        },
        "skill_code": {
          "$ref": "#/$defs/SkillId"
        }
      },
      "required": [
        "kind",
        "skill_code"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "goal"
        },
        "goal_id": {
          "$ref": "#/$defs/GoalId"
        }
      },
      "required": [
        "kind",
        "goal_id"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "SkillId": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9-]+)+$"
    },
    "GoalId": {
      "type": "string",
      "pattern": "^gol_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    }
  }
}
