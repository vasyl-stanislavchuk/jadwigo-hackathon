{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assignment_id": {
      "$ref": "#/$defs/AssignmentId"
    },
    "lesson_id": {
      "$ref": "#/$defs/LessonId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "grade": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "question_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "first_say": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "assignment_id",
    "lesson_id",
    "title",
    "language",
    "subject",
    "grade",
    "question_count",
    "first_say"
  ],
  "additionalProperties": false,
  "$defs": {
    "AssignmentId": {
      "type": "string",
      "pattern": "^asg_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "LessonId": {
      "type": "string",
      "pattern": "^les_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "Language": {
      "type": "string",
      "enum": [
        "pl",
        "en",
        "uk"
      ]
    },
    "Subject": {
      "type": "string",
      "enum": [
        "math",
        "polish",
        "english"
      ]
    }
  }
}
