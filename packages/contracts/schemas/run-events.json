        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "type": {
          "type": "string",
          "const": "model_response"
        },
        "payload": {
          "type": "object",
          "properties": {
            "response_id": {
              "type": "string",
              "minLength": 1
            },
            "call_no": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "tool_calls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ToolCall"
              }
            },
            "usage": {
              "$ref": "#/$defs/ModelUsage"
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "tier": {
              "$ref": "#/$defs/ModelTier"
            }
          },
          "required": [
            "response_id",
            "call_no",
            "text",
            "tool_calls",
            "usage",
            "cost_usd",
            "model",
            "tier"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "seq",
        "event_id",
        "created_at",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "verb": {
          "$ref": "#/$defs/VerbName"
        },
        "input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "call_id",
        "verb",
        "input"
      ],
      "additionalProperties": false
    },
    "VerbName": {
      "type": "string",
      "enum": [
        "lesson_draft",
        "lesson_show",
        "lesson_edit",
        "lesson_check",
        "question_search"
      ]
    },
    "ModelUsage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_tokens"
      ],
      "additionalProperties": false
    },
    "ModelTier": {
      "type": "string",
      "enum": [
        "private",
        "contributor"
      ]
    },
    "ToolCallEvent": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "type": {
          "type": "string",
          "const": "tool_call"
        },
        "payload": {
          "$ref": "#/$defs/ToolCall"
        }
      },
      "required": [
        "run_id",
        "seq",
        "event_id",
        "created_at",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "ToolResultEvent": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "type": {
          "type": "string",
          "const": "tool_result"
        },
        "payload": {
          "type": "object",
          "properties": {
            "call_id": {
              "type": "string",
              "minLength": 1
            },
            "verb": {
              "$ref": "#/$defs/VerbName"
            },
            "output": {
              "anyOf": [
                {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                {
                  "type": "null"
                }
              ]
            },
            "error": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RunError"
                },
                {
                  "type": "null"
                }
              ]
            },
            "view": {
              "$ref": "#/$defs/ToolView"
            }
          },
          "required": [
            "call_id",
            "verb",
            "output",
            "error"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "seq",
        "event_id",
        "created_at",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "RunError": {
      "type": "object",
