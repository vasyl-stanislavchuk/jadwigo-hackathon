            "summary": {
              "type": "string"
            },
            "choose": {
              "$ref": "#/$defs/ChooseForm"
            }
          },
          "required": [
            "call_id",
            "verb",
            "summary"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "seq",
        "event_id",
        "created_at",
        "type",
        "payload"
