      "enum": [
        "lesson_draft",
        "lesson_show",
        "lesson_edit",
        "lesson_check",
        "question_search"
      ]
    },
    "LessonRevisionEvent": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event_id": {
          "$ref": "#/$defs/EventId"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
