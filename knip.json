{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [".claude/hooks/guard.ts"],
      "project": [".claude/hooks/*.ts"]
    },
    "tools": {
      "entry": ["src/check-*.ts"]
    },
    "apps/web": {
      "entry": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "*.config.ts"],
      "vite": false,
      "playwright": false
    }
  },
  "ignoreBinaries": ["make", "gitleaks", "uv", "psql"],
  "ignoreWorkspaces": ["apps/cli"]
}
