{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [".claude/hooks/guard.ts"],
      "project": [".claude/hooks/*.ts"]
    },
    "tools": {
      "entry": ["src/check-*.ts"]
    },
    "apps/docs": {
      "project": ["src/**/*.{ts,astro,mdx}", "scripts/*.ts", "*.mjs"],
      "ignoreDependencies": ["satteri", "@jadwigo/cli", "@jadwigo/api-client"]
    },
    "apps/web": {
      "entry": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.spec.ts", "e2e/auth-server.ts"],
      "project": ["src/**/*.{ts,tsx}", "dev/**/*.ts", "e2e/**/*.ts", "*.config.ts"],
      "vite": false,
      "playwright": false
    },
    "packages/copy": {
      "ignore": ["src/paraglide/**"]
    }
  },
  "ignoreBinaries": ["make", "gitleaks", "uv", "psql"],
  "ignoreWorkspaces": ["apps/cli"]
}
