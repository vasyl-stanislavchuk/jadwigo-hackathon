{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":pinAllExceptPeerDependencies"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "groupName": "lint and type tooling",
      "matchPackageNames": [
        "@biomejs/biome",
        "knip",
        "dependency-cruiser",
        "typescript",
        "turbo",
        "lefthook"
      ]
    },
    {
      "groupName": "test tooling",
      "matchPackageNames": ["vitest", "fast-check", "@types/node", "@types/bun", "postgres"]
    },
    { "groupName": "GitHub Actions", "matchManagers": ["github-actions"] },
    { "groupName": "mise tools", "matchManagers": ["mise"] },
    {
      "description": "Terraform's binary (mise.toml) and required_version (infra/terraform/versions.tf) move in one PR, so they never disagree",
      "groupName": "Terraform",
      "matchPackageNames": ["terraform", "hashicorp/terraform"]
    },
    { "groupName": "jw CLI (uv)", "matchManagers": ["pep621"] },
    {
      "description": "dependency-cruiser cannot read TypeScript 7's API yet (dl-5ssh.34.2); lift when it can",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "requires-python is a floor for whoever runs jw, not a pin; the runner's Python decides",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "uv_build stays a range that moves with the uv pinned in mise.toml",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["uv_build"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Node 24 is the runtime everywhere (Lambda nodejs24.x); its types follow it",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    }
  ]
}
